@using Microsoft.AspNetCore.Http
@{
    ViewData["Title"] = "Thanh toán thành công";
    var isCustomer = Context.Session.GetInt32("CurrentTableId") != null;
    Layout = isCustomer ? "_CustomerLayout" : "_Layout";
}

<div class="container mt-5 pt-5 text-center">
    <div class="card shadow border-0 mx-auto" style="max-width: 500px;">
        <div class="card-body p-5">
            <i class="bi bi-check-circle-fill text-success" style="font-size: 5rem;"></i>
            <h2 class="fw-bold mt-4 mb-3">Thanh Toán Thành Công!</h2>
            <p class="text-muted fs-5">@ViewBag.Message</p>
            <p class="mb-4">Cảm ơn bạn đã sử dụng dịch vụ của chúng tôi. Chúc bạn có một trải nghiệm tuyệt vời!</p>
            
            @if (isCustomer)
            {
                <a asp-controller="Client" asp-action="LeaveTable" class="btn btn-primary rounded-pill px-5 py-2 fw-bold">
                    <i class="bi bi-box-arrow-right me-1"></i> Rời bàn & Hoàn tất
                </a>
            }
            else
            {
                <a asp-controller="Home" asp-action="Index" class="btn btn-primary rounded-pill px-5 py-2 fw-bold">
                    <i class="bi bi-house-door-fill me-1"></i> Về trang chủ
                </a>
            }
        </div>
    </div>
</div>
