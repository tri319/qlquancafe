@using Microsoft.AspNetCore.Http
@{
    ViewData["Title"] = "Thanh toán thất bại";
    var isCustomer = Context.Session.GetInt32("CurrentTableId") != null;
    var tableId = Context.Session.GetInt32("CurrentTableId");
    Layout = isCustomer ? "_CustomerLayout" : "_Layout";
}

<div class="container mt-5 pt-5 text-center">
    <div class="card shadow border-0 mx-auto" style="max-width: 500px;">
        <div class="card-body p-5">
            <i class="bi bi-x-circle-fill text-danger" style="font-size: 5rem;"></i>
            <h2 class="fw-bold mt-4 mb-3">Giao Dịch Thất Bại</h2>
            <p class="text-muted fs-5">@ViewBag.Message</p>
            <p class="mb-4">Giao dịch của bạn chưa được thực hiện thành công. Vui lòng thử lại hoặc liên hệ với nhân viên để được hỗ trợ.</p>
            
            @if (isCustomer)
            {
                <a asp-controller="Orders" asp-action="ActiveOrder" asp-route-tableId="@tableId" class="btn btn-danger rounded-pill px-5 py-2 fw-bold">
                    <i class="bi bi-receipt-cutoff me-1"></i> Quay lại hóa đơn
                </a>
            }
            else
            {
                <a asp-controller="Home" asp-action="Index" class="btn btn-danger rounded-pill px-5 py-2 fw-bold">
                    <i class="bi bi-house-door-fill me-1"></i> Về trang chủ
                </a>
            }
        </div>
    </div>
</div>
