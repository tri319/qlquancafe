@model IEnumerable<QLquancafe.Models.Product>

@{
    ViewData["Title"] = "Thực Đơn Sản Phẩm";
}

<div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-3 mb-5 stagger-item" style="--i: 1;">
    <div>
        <span class="text-uppercase tracking-wider text-muted fw-bold" style="font-size: 0.75rem; letter-spacing: 1.5px;">Quản Trị Hệ Thống</span>
        <h2 class="fw-extrabold mb-0 typewriter-text" style="color: var(--cafe-primary); font-weight: 800;">
            <i class="bi bi-journal-richtext me-2" style="color: var(--cafe-secondary);"></i> THỰC ĐƠN
        </h2>
    </div>
    
    <a asp-action="Create" class="btn btn-cafe btn-pill shadow magnetic-btn">
        <i class="bi bi-plus-circle-fill"></i> Thêm món mới
    </a>
</div>

<!-- Modern Glass Data Table -->
<div class="table-modern-wrapper stagger-item" style="--i: 2;">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th class="ps-4">Hình ảnh</th>
                    <th>Tên món</th>
                    <th>Loại món</th>
                    <th class="text-end">Đơn giá</th>
                    <th class="text-center pe-4" style="width: 250px;">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="5" class="text-center text-muted py-5">
                            <div class="py-4">
                                <i class="bi bi-inbox text-light display-3 opacity-25"></i>
                                <p class="mt-2 mb-0 fw-bold fs-5 text-muted">Thực đơn hiện đang trống.</p>
                            </div>
                        </td>
                    </tr>
                }
                @{ int index = 3; }
                @foreach (var item in Model)
                {
                    <tr class="stagger-item" style="--i: @index;">
                        <td class="ps-4">
                            <div class="position-relative overflow-hidden shadow-sm" style="width: 60px; height: 60px; border-radius: 12px; border: 1px solid rgba(245, 166, 35, 0.2);">
                                @if (!string.IsNullOrEmpty(item.ImageUrl))
                                {
                                    <img src="@item.ImageUrl" alt="@item.Name" class="w-100 h-100 object-fit-cover transition-transform hover-scale" />
                                }
                                else
                                {
                                    <div class="w-100 h-100 d-flex align-items-center justify-content-center" style="background: linear-gradient(135deg, var(--cafe-surface), var(--cafe-surface-hover));">
                                        <i class="bi bi-cup-hot fs-4 text-muted"></i>
                                    </div>
                                }
                            </div>
                        </td>
                        <td>
                            <strong class="fs-6" style="color: var(--cafe-text);">@item.Name</strong>
                        </td>
                        <td>
                            <span class="badge bg-secondary-subtle px-3 py-2 rounded-pill border">
                                @(item.Category?.Name ?? "Chưa phân loại")
                            </span>
                        </td>
                        <td class="text-end text-danger fw-extrabold fs-5 font-monospace">
                            @item.Price.ToString("N0") đ
                        </td>
                        <td class="text-center pe-4">
                            <div class="d-inline-flex gap-2">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning btn-pill magnetic-btn" style="font-size: 0.85rem;" title="Sửa">
                                    <i class="bi bi-pencil-square"></i>
                                </a>
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info btn-pill magnetic-btn" style="font-size: 0.85rem;" title="Chi tiết">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger btn-pill magnetic-btn" style="font-size: 0.85rem;" title="Xóa">
                                    <i class="bi bi-trash"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                    index++;
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Magnetic Buttons
            const magneticBtns = document.querySelectorAll('.magnetic-btn');
            magneticBtns.forEach(btn => {
                btn.addEventListener('mousemove', e => {
                    const rect = btn.getBoundingClientRect();
                    const h = rect.width / 2;
                    const x = e.clientX - rect.left - h;
                    const y = e.clientY - rect.top - rect.height / 2;
                    btn.style.transform = `translate(${x * 0.2}px, ${y * 0.2}px)`;
                });
                btn.addEventListener('mouseleave', () => {
                    btn.style.transform = `translate(0px, 0px)`;
                });
            });
        });
    </script>
}

@section Styles {
    <style>
        .hover-scale {
            transition: transform 0.3s ease;
        }
        tr:hover .hover-scale {
            transform: scale(1.15);
        }
    </style>
}