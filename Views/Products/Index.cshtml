@model IEnumerable<QLquancafe.Models.Product>

@{
    ViewData["Title"] = "Danh mục món ăn";
}

<div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-3 mb-5 animate-fade-up">
    <div>
        <span class="text-uppercase tracking-wider text-muted fw-bold" style="font-size: 0.75rem; letter-spacing: 1.5px;">Quản Trị Hệ Thống</span>
        <h2 class="fw-extrabold mb-0" style="color: var(--cafe-primary); font-weight: 800;">
            <i class="bi bi-cup-straw me-2" style="color: var(--cafe-secondary);"></i> QUẢN LÝ THỰC ĐƠN
        </h2>
    </div>
    
    <a asp-action="Create" class="btn btn-cafe btn-pill shadow">
        <i class="bi bi-plus-circle-fill"></i> Thêm món ăn mới
    </a>
</div>

<!-- Modern Glass Data Table -->
<div class="table-modern-wrapper animate-fade-up" style="animation-delay: 0.1s;">
    <table class="table table-hover align-middle">
        <thead>
            <tr>
                <th class="ps-4" style="width: 120px;">Hình ảnh</th>
                <th>Tên sản phẩm</th>
                <th>Loại món</th>
                <th>Giá bán</th>
                <th class="text-center pe-4" style="width: 220px;">Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="5" class="text-center text-muted py-5">
                        <div class="py-4">
                            <i class="bi bi-inbox text-light display-3"></i>
                            <p class="mt-2 mb-0 fw-bold fs-5">Thực đơn hiện tại đang trống.</p>
                        </div>
                    </td>
                </tr>
            }
            @foreach (var item in Model)
            {
                <tr>
                    <td class="ps-4">
                        @if (!string.IsNullOrEmpty(item.ImageUrl))
                        {
                            <img src="@item.ImageUrl" class="rounded-3 shadow-sm border border-light" style="width: 55px; height: 55px; object-fit: cover;" alt="@item.Name" />
                        }
                        else
                        {
                            <div class="rounded-3 shadow-sm bg-light d-flex align-items-center justify-content-center" style="width: 55px; height: 55px; border: 1.5px dashed rgba(62, 39, 35, 0.15);">
                                <i class="bi bi-image text-muted fs-4"></i>
                            </div>
                        }
                    </td>
                    <td>
                        <strong class="text-dark fs-6">@item.Name</strong>
                    </td>
                    <td>
                        <span class="badge bg-info-subtle text-info rounded-pill px-3">
                            <i class="bi bi-tag-fill me-1"></i> @item.Category?.Name
                        </span>
                    </td>
                    <td>
                        <span class="text-danger fw-extrabold font-monospace">@item.Price.ToString("N0") VNĐ</span>
                    </td>
                    <td class="text-center pe-4">
                        <div class="d-inline-flex gap-1">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-light btn-pill border" style="font-size: 0.85rem;">
                                <i class="bi bi-pencil-square text-warning"></i> Sửa
                            </a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-light btn-pill border" style="font-size: 0.85rem;">
                                <i class="bi bi-trash text-danger"></i> Xóa
                            </a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>