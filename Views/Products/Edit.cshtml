@model QLquancafe.Models.Product

@{
    ViewData["Title"] = "Chỉnh sửa";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow border-warning">
            <div class="card-header bg-warning">
                <h4 class="mb-0">Cập nhật thông tin món</h4>
            </div>
            <div class="card-body">
                <form asp-action="Edit" enctype="multipart/form-data">
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="ImageUrl" /> <div class="mb-3">
                        <label asp-for="Name" class="form-label fw-bold">Tên món</label>
                        <input asp-for="Name" class="form-control" />
                    </div>

                    <div class="mb-3 text-center">
                        <label class="d-block mb-2">Ảnh hiện tại:</label>
                        <img src="@Model.ImageUrl" class="img-thumbnail" style="height: 120px;" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Thay ảnh mới (nếu muốn)</label>
                        <input type="file" name="ImageFile" class="form-control" />
                    </div>

                    <div class="mb-3">
                        <label asp-for="Price" class="form-label fw-bold">Giá bán</label>
                        <input asp-for="Price" class="form-control" />
                    </div>

                    <div class="mb-3">
                        <label asp-for="CategoryId" class="form-label fw-bold">Loại món</label>
                        <select asp-for="CategoryId" class="form-select" asp-items="ViewBag.CategoryId"></select>
                    </div>

                    <div class="d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-outline-secondary">Hủy</a>
                        <button type="submit" class="btn btn-warning px-4 text-dark fw-bold">Cập nhật</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>