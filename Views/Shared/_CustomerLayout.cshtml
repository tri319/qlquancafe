@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor

@{
    var tableId = HttpContextAccessor.HttpContext.Session.GetInt32("CurrentTableId");
    var tableName = HttpContextAccessor.HttpContext.Session.GetString("CurrentTableName");
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Thực Đơn Điện Tử</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/QLquancafe.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;700;800&display=swap" rel="stylesheet">

    @await RenderSectionAsync("Styles", required: false)
    
    <style>
        body {
            font-family: 'Outfit', sans-serif;
            background-color: #FAF8F5;
            padding-bottom: 80px; /* Chừa khoảng trống cho thanh điều hướng dưới */
        }

        /* Thanh tiêu đề trên (Mobile-First Top Bar) */
        .customer-top-bar {
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border-bottom: 1px solid rgba(141, 110, 99, 0.1);
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            z-index: 1000;
            height: 64px;
            display: flex;
            align-items: center;
            padding: 0 1.25rem;
        }

        .table-badge {
            background-color: var(--cafe-primary);
            color: #FFFFFF;
            font-weight: 700;
            padding: 0.45rem 1.1rem;
            border-radius: 50px;
            font-size: 0.85rem;
            box-shadow: 0 4px 10px rgba(62, 39, 35, 0.15);
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }

        /* Thanh điều hướng dưới (Sticky Bottom Nav) */
        .customer-bottom-nav {
            background: rgba(255, 255, 255, 0.96);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border-top: 1px solid rgba(141, 110, 99, 0.1);
            position: fixed;
            bottom: 0;
            left: 0;
            right: 0;
            height: 72px;
            z-index: 1000;
            display: flex;
            justify-content: space-around;
            align-items: center;
            box-shadow: 0 -5px 20px rgba(62, 39, 35, 0.05);
        }

        .nav-tab-item {
            display: flex;
            flex-direction: column;
            align-items: center;
            text-decoration: none;
            color: var(--cafe-text-muted);
            font-size: 0.78rem;
            font-weight: 600;
            transition: all 0.25s ease;
            background: none;
            border: none;
            padding: 6px 0;
            width: 22%;
        }

        .nav-tab-item i {
            font-size: 1.45rem;
            margin-bottom: 2px;
            transition: transform 0.2s ease;
        }

        .nav-tab-item:hover, .nav-tab-item.active {
            color: var(--cafe-primary) !important;
        }

        .nav-tab-item.active i {
            transform: translateY(-3px);
            color: var(--cafe-secondary);
        }

        .main-content-wrapper {
            margin-top: 84px;
        }

        /* Hộp thoại thông báo khi gọi nhân viên */
        .call-success-popup {
            position: fixed;
            top: 45%;
            left: 50%;
            transform: translate(-50%, -50%) scale(0.9);
            background-color: #FFFFFF;
            border-radius: 18px;
            box-shadow: 0 20px 50px rgba(62, 39, 35, 0.16);
            padding: 2.2rem;
            z-index: 2000;
            text-align: center;
            opacity: 0;
            pointer-events: none;
            transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            max-width: 320px;
            width: 85%;
        }
        .call-success-popup.show {
            opacity: 1;
            transform: translate(-50%, -50%) scale(1);
            pointer-events: auto;
        }

        @@keyframes ring-bell {
            0%, 100% { transform: rotate(0); }
            15% { transform: rotate(15deg); }
            30% { transform: rotate(-15deg); }
            45% { transform: rotate(10deg); }
            60% { transform: rotate(-10deg); }
            75% { transform: rotate(4deg); }
            90% { transform: rotate(-4deg); }
        }
        .animate-bell {
            animation: ring-bell 1s ease-in-out infinite;
        }
    </style>
</head>
<body>

    <!-- Top Navigation Bar -->
    <div class="customer-top-bar justify-content-between">
        <span class="fw-bold d-flex align-items-center" style="color: var(--cafe-primary); font-size: 1.2rem; font-weight: 800; letter-spacing: 0.5px;">
            <i class="bi bi-cup-hot-fill text-warning me-2 fs-4 animate-pulse"></i> QL CAFE
        </span>
        @if (!string.IsNullOrEmpty(tableName))
        {
            <span class="table-badge"><i class="bi bi-geo-alt-fill text-warning"></i> @tableName</span>
        }
        else
        {
            <span class="table-badge">E-MENU</span>
        }
    </div>

    <!-- Main Layout Wrapper -->
    <div class="container main-content-wrapper animate-fade-up">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <!-- Sticky Bottom Navigation Bar -->
    <div class="customer-bottom-nav">
        <!-- Tab 1: Menu điện tử -->
        <a href="/Orders/Create?tableId=@tableId" class="nav-tab-item" id="menu-tab">
            <i class="bi bi-book-half"></i>
            <span>Thực đơn</span>
        </a>

        <!-- Tab 2: Xem hóa đơn/Thanh toán -->
        <a href="/Orders/ActiveOrder?tableId=@tableId" class="nav-tab-item" id="bill-tab">
            <i class="bi bi-receipt-cutoff"></i>
            <span>Hóa đơn</span>
        </a>

        <!-- Tab 3: Gọi phục vụ nhanh -->
        <button type="button" class="nav-tab-item" id="call-staff-btn">
            <i class="bi bi-bell-fill"></i>
            <span>Gọi phục vụ</span>
        </button>

        <!-- Tab 4: Thoát/Rời bàn -->
        <a asp-controller="Client" asp-action="LeaveTable" class="nav-tab-item text-danger">
            <i class="bi bi-box-arrow-right"></i>
            <span>Rời bàn</span>
        </a>
    </div>

    <!-- Call staff animated alert popup -->
    <div class="call-success-popup" id="callPopup">
        <div class="rounded-circle bg-success-subtle text-success d-inline-flex align-items-center justify-content-center mb-3" style="width: 60px; height: 60px;">
            <i class="bi bi-bell-ring-fill fs-3 animate-bell"></i>
        </div>
        <h5 class="fw-bold mb-2" style="color: var(--cafe-primary);">Đang Gọi Nhân Viên</h5>
        <p class="text-muted small mb-0">Yêu cầu phục vụ đã được chuyển đến quầy. Vui lòng đợi trong giây lát!</p>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
        $(document).ready(function() {
            var path = window.location.pathname.toLowerCase();
            if (path.indexOf("create") > -1) {
                $("#menu-tab").addClass("active");
            } else if (path.indexOf("details") > -1 || path.indexOf("activeorder") > -1) {
                $("#bill-tab").addClass("active");
            }

            $("#call-staff-btn").click(function() {
                var popup = $("#callPopup");
                popup.addClass("show");
                setTimeout(function() {
                    popup.removeClass("show");
                }, 3500);
            });
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>