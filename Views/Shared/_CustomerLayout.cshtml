@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor

@{
    var tableId = HttpContextAccessor.HttpContext.Session.GetInt32("CurrentTableId");
    var tableName = HttpContextAccessor.HttpContext.Session.GetString("CurrentTableName");
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Thực Đơn Điện Tử</title>

    <script>
        (function () {
            const theme = localStorage.getItem('cafe-theme') || 'light';
            document.documentElement.setAttribute('data-theme', theme);
        })();
    </script>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/QLquancafe.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;700;800&display=swap" rel="stylesheet">

    @await RenderSectionAsync("Styles", required: false)
    
    <style>
        body {
            padding-bottom: 90px;
        }

        /* Top Bar - Glass */
        .customer-top-bar {
            background: var(--glass-bg);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border-bottom: 1px solid var(--glass-border);
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            z-index: 1000;
            height: 68px;
            display: flex;
            align-items: center;
            padding: 0 1.5rem;
            box-shadow: var(--glass-shadow);
        }

        .table-badge {
            background: linear-gradient(135deg, var(--cafe-primary) 0%, var(--cafe-secondary) 100%);
            color: #0D0D0D;
            font-weight: 700;
            padding: 0.5rem 1.2rem;
            border-radius: var(--radius-pill);
            font-size: 0.8rem;
            box-shadow: 0 0 15px rgba(245, 166, 35, 0.3);
            display: inline-flex;
            align-items: center;
            gap: 6px;
            letter-spacing: 0.5px;
        }

        /* Bottom Nav - Glass */
        .customer-bottom-nav {
            background: var(--glass-bg);
            backdrop-filter: blur(24px);
            -webkit-backdrop-filter: blur(24px);
            position: fixed;
            bottom: 0;
            left: 0;
            right: 0;
            height: 76px;
            z-index: 1000;
            display: flex;
            justify-content: space-around;
            align-items: center;
            box-shadow: 0 -8px 30px rgba(0, 0, 0, 0.2);
            border-radius: var(--radius-md) var(--radius-md) 0 0;
        }
        
        .customer-bottom-nav::before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 1.5px;
            background: linear-gradient(90deg, transparent, var(--cafe-primary), var(--cafe-secondary), transparent);
            box-shadow: 0 0 10px var(--cafe-primary);
        }

        .nav-tab-item {
            display: flex;
            flex-direction: column;
            align-items: center;
            text-decoration: none;
            color: var(--cafe-text-muted);
            font-size: 0.75rem;
            font-weight: 600;
            transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
            background: none;
            border: none;
            padding: 8px 0;
            width: 22%;
        }

        .nav-tab-item i {
            font-size: 1.5rem;
            margin-bottom: 3px;
            transition: transform 0.25s cubic-bezier(0.175, 0.885, 0.32, 1.275), color 0.25s, text-shadow 0.25s;
        }

        .nav-tab-item:hover, .nav-tab-item.active {
            color: var(--cafe-primary) !important;
        }

        .nav-tab-item.active i {
            transform: translateY(-4px) scale(1.12);
            color: var(--cafe-primary);
            text-shadow: 0 0 10px rgba(245, 166, 35, 0.5);
        }

        .main-content-wrapper {
            margin-top: 92px;
        }

        .nav-tab-item.calling {
            pointer-events: none;
        }

        @@keyframes ring-bell {
            0%, 100% { transform: rotate(0); }
            15% { transform: rotate(18deg); }
            30% { transform: rotate(-18deg); }
            45% { transform: rotate(12deg); }
            60% { transform: rotate(-12deg); }
            75% { transform: rotate(5deg); }
            90% { transform: rotate(-5deg); }
        }
        .animate-bell {
            animation: ring-bell 1s ease-in-out infinite;
        }
    </style>
</head>
<body>
    <!-- Scroll Progress Bar -->
    <div class="scroll-progress" id="scrollProgress"></div>

    <!-- Top Navigation Bar -->
    <div class="customer-top-bar justify-content-between">
        <span class="fw-bold d-flex align-items-center" style="font-size: 1.25rem; font-weight: 800; letter-spacing: 0.5px;">
            <div class="logo-icon-wrap me-2">
                <svg viewBox="0 0 40 50" width="32" height="32">
                    <circle cx="20" cy="32" r="14" fill="url(#logoGradTop)" />
                    <text x="20" y="36" text-anchor="middle" fill="#0D0D0D" font-size="14" font-weight="800">☕</text>
                    <path class="steam-path s1" d="M14 18 Q14 12 18 10 Q22 8 18 2" fill="none" stroke="rgba(245,166,35,0.6)" stroke-width="1.5" stroke-linecap="round"/>
                    <path class="steam-path s2" d="M20 16 Q20 10 24 8 Q28 6 24 0" fill="none" stroke="rgba(232,101,26,0.5)" stroke-width="1.5" stroke-linecap="round"/>
                    <path class="steam-path s3" d="M26 18 Q26 12 22 10 Q18 8 22 2" fill="none" stroke="rgba(255,213,79,0.5)" stroke-width="1.5" stroke-linecap="round"/>
                    <defs>
                        <linearGradient id="logoGradTop" x1="0%" y1="0%" x2="100%" y2="100%">
                            <stop offset="0%" stop-color="#F5A623" />
                            <stop offset="100%" stop-color="#E8651A" />
                        </linearGradient>
                    </defs>
                </svg>
            </div>
            <span class="logo-text">QL CAFE</span>
        </span>
        <div class="d-flex align-items-center gap-2">
            <button id="themeToggleBtn" class="btn btn-sm btn-pill btn-light border d-flex align-items-center justify-content-center" style="width: 38px; height: 38px; padding: 0;" title="Chuyển chế độ sáng/tối">
                <i class="bi bi-sun-fill fs-5" id="themeToggleIcon" style="color: var(--cafe-secondary);"></i>
            </button>
            @if (!string.IsNullOrEmpty(tableName))
            {
                <span class="table-badge"><i class="bi bi-geo-alt-fill"></i> @tableName</span>
            }
            else
            {
                <span class="table-badge"><i class="bi bi-stars animate-steam"></i> E-MENU</span>
            }
        </div>
    </div>

    <!-- Main Layout Wrapper -->
    <div class="container main-content-wrapper animate-fade-up">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <!-- Sticky Bottom Navigation Bar -->
    <div class="customer-bottom-nav">
        <!-- Tab 1: Menu điện tử -->
        <a href="/Orders/Create?tableId=@tableId" class="nav-tab-item" id="menu-tab">
            <i class="bi bi-journal-richtext"></i>
            <span>Thực đơn</span>
        </a>

        <!-- Tab 2: Xem hóa đơn/Thanh toán -->
        <a href="/Orders/ActiveOrder?tableId=@tableId" class="nav-tab-item" id="bill-tab">
            <i class="bi bi-receipt-cutoff"></i>
            <span>Hóa đơn</span>
        </a>

        <!-- Tab 3: Gọi phục vụ nhanh -->
        <button type="button" class="nav-tab-item" id="call-staff-btn">
            <i class="bi bi-bell-fill" id="callBtnIcon" style="color: var(--cafe-primary);"></i>
            <span id="callText">Gọi phục vụ</span>
        </button>

        <!-- Tab 4: Thoát/Rời bàn -->
        <a asp-controller="Client" asp-action="LeaveTable" class="nav-tab-item" style="color: var(--danger-color);">
            <i class="bi bi-box-arrow-right"></i>
            <span>Rời bàn</span>
        </a>
    </div>

    <!-- Toast Container (from site.css) -->
    <div class="toast-container" id="toastContainer"></div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/6.0.1/signalr.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
        $(document).ready(function() {
            // Khởi tạo SignalR Hub Connection
            var connection = new signalR.HubConnectionBuilder()
                .withUrl("/notificationHub")
                .withAutomaticReconnect()
                .build();

            connection.start().then(function () {
                console.log("SignalR Connected!");
            }).catch(function (err) {
                console.error("SignalR Connection Error: ", err.toString());
            });

            // Set active tab based on URL
            var path = window.location.pathname.toLowerCase();
            if (path.indexOf("create") > -1) {
                $("#menu-tab").addClass("active");
            } else if (path.indexOf("details") > -1 || path.indexOf("activeorder") > -1) {
                $("#bill-tab").addClass("active");
            }

            // Scroll Progress
            $(window).on('scroll', function() {
                var scrollTop = $(window).scrollTop();
                var docHeight = $(document).height() - $(window).height();
                var scrollPercent = docHeight > 0 ? (scrollTop / docHeight) * 100 : 0;
                $('#scrollProgress').css('width', scrollPercent + '%');
            });

            // Call Staff with Toast (Real-time SignalR)
            $("#call-staff-btn").click(function() {
                var $btn = $(this);
                var $icon = $("#callBtnIcon");
                var $text = $("#callText");
                
                if ($btn.hasClass("calling")) return; // Prevent spam
                
                // Animate button
                $btn.addClass("calling");
                $icon.removeClass("bi-bell-fill").addClass("bi-bell-ring-fill animate-bell").css("color", "var(--success-color)");
                $text.text("Đang gọi...").css("color", "var(--success-color)");
                
                // Gửi sự kiện thời gian thực qua SignalR
                var currentTableId = @(tableId ?? 0);
                var currentTableName = '@Html.Raw(tableName ?? "Bàn")';
                
                if (currentTableId > 0 && connection.state === signalR.HubConnectionState.Connected) {
                    connection.invoke("SendServiceCall", currentTableId, currentTableName).catch(function (err) {
                        console.error("SendServiceCall error: ", err.toString());
                    });
                }
                
                // Show toast
                showToast("🔔 Yêu cầu đã gửi tới quầy pha chế. Nhân viên sẽ đến ngay!", "success");
                
                // Reset after 4s
                setTimeout(function() {
                    $btn.removeClass("calling");
                    $icon.removeClass("bi-bell-ring-fill animate-bell").addClass("bi-bell-fill").css("color", "var(--cafe-primary)");
                    $text.text("Gọi phục vụ").css("color", "");
                }, 4000);
            });
            
            // Ripple effect
            $(document).on('click', '.btn', function(e) {
                var $btn = $(this);
                if($btn.css('position') === 'static') $btn.css('position', 'relative');
                var ripple = $('<span class="ripple"></span>');
                var size = Math.max($btn.outerWidth(), $btn.outerHeight());
                ripple.css({
                    width: size, height: size,
                    left: e.pageX - $btn.offset().left - size / 2,
                    top: e.pageY - $btn.offset().top - size / 2
                });
                $btn.append(ripple);
                setTimeout(function() { ripple.remove(); }, 600);
            });

            // Theme Toggle Logic
            function updateThemeIcon(theme) {
                const icon = $('#themeToggleIcon');
                if (theme === 'light') {
                    icon.removeClass('bi-moon-stars-fill').addClass('bi-sun-fill').css('color', 'var(--cafe-secondary)');
                } else {
                    icon.removeClass('bi-sun-fill').addClass('bi-moon-stars-fill').css('color', 'var(--cafe-primary)');
                }
            }

            const currentTheme = localStorage.getItem('cafe-theme') || 'light';
            updateThemeIcon(currentTheme);

            $('#themeToggleBtn').on('click', function() {
                const activeTheme = document.documentElement.getAttribute('data-theme') || 'light';
                const newTheme = activeTheme === 'dark' ? 'light' : 'dark';
                
                document.documentElement.setAttribute('data-theme', newTheme);
                localStorage.setItem('cafe-theme', newTheme);
                updateThemeIcon(newTheme);

                showToast(newTheme === 'light' ? '🔆 Đã chuyển sang Giao diện Sáng Luxury' : '🌙 Đã chuyển sang Giao diện Tối Luxury', 'info');
            });
        });
        
        function showToast(message, type) {
            type = type || 'default';
            var toast = $('<div class="toast-item toast-' + type + '">' +
                '<div style="font-weight:600;">' + message + '</div>' +
                '<div class="toast-progress"></div>' +
                '</div>');
            $('#toastContainer').append(toast);
            setTimeout(function() {
                toast.css('animation', 'toastSlideOut 0.4s forwards');
                setTimeout(function() { toast.remove(); }, 400);
            }, 4000);
        }
    </script>
    
    <style>
        .steam-path {
            stroke-dasharray: 30;
            stroke-dashoffset: 30;
            animation: steamDraw 2.5s ease-in-out infinite;
        }
        .steam-path.s2 { animation-delay: 0.3s; }
        .steam-path.s3 { animation-delay: 0.6s; }

        @@keyframes steamDraw {
            0% { stroke-dashoffset: 30; opacity: 0; }
            30% { opacity: 0.7; }
            70% { opacity: 0.5; }
            100% { stroke-dashoffset: -30; opacity: 0; }
        }

        .logo-text {
            background: linear-gradient(90deg, var(--cafe-primary) 0%, var(--cafe-accent) 50%, var(--cafe-primary) 100%);
            background-size: 200% auto;
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            animation: logoShimmer 3s linear infinite;
        }
        @@keyframes logoShimmer {
            0% { background-position: 0% center; }
            100% { background-position: 200% center; }
        }
    </style>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>