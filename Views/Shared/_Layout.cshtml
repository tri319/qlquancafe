@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Quản Lý Quán Cafe</title>

    <script>
        (function () {
            const theme = localStorage.getItem('cafe-theme') || 'light';
            document.documentElement.setAttribute('data-theme', theme);
        })();
    </script>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/QLquancafe.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <!-- Scroll Progress Bar -->
    <div class="scroll-progress" id="scrollProgress"></div>

    <header>
        <nav class="navbar navbar-sidebar navbar-expand-lg navbar-dark fixed-top glass-panel px-3 px-md-4 py-3">
            <div class="container-fluid">
                <!-- Animated Coffee Steam Logo -->
                <a class="navbar-brand fw-extrabold d-flex align-items-center mb-0 mb-lg-4 mt-1" style="font-weight: 800; letter-spacing: 0.5px;" asp-area="" asp-controller="Home" asp-action="Index">
                    <div class="logo-icon-wrap me-2">
                        <svg class="coffee-steam-svg" viewBox="0 0 40 50" width="38" height="38">
                            <circle cx="20" cy="32" r="14" fill="url(#logoGrad)" />
                            <text x="20" y="36" text-anchor="middle" fill="#0D0D0D" font-size="14" font-weight="800">☕</text>
                            <!-- Steam Paths -->
                            <path class="steam-path s1" d="M14 18 Q14 12 18 10 Q22 8 18 2" fill="none" stroke="rgba(245,166,35,0.5)" stroke-width="1.5" stroke-linecap="round"/>
                            <path class="steam-path s2" d="M20 16 Q20 10 24 8 Q28 6 24 0" fill="none" stroke="rgba(232,101,26,0.4)" stroke-width="1.5" stroke-linecap="round"/>
                            <path class="steam-path s3" d="M26 18 Q26 12 22 10 Q18 8 22 2" fill="none" stroke="rgba(255,213,79,0.4)" stroke-width="1.5" stroke-linecap="round"/>
                            <defs>
                                <linearGradient id="logoGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                                    <stop offset="0%" stop-color="#F5A623" />
                                    <stop offset="100%" stop-color="#E8651A" />
                                </linearGradient>
                            </defs>
                        </svg>
                    </div>
                    <span class="logo-text fs-4 fw-bold text-uppercase">QL CAFE</span>
                </a>
                
                <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse">
                    <span class="bi bi-list fs-2" style="color: var(--cafe-primary);"></span>
                </button>
                
                <div class="navbar-collapse collapse d-lg-inline-flex justify-content-between align-items-center mt-3 mt-lg-0">
                    <ul class="navbar-nav flex-grow-1 align-items-lg-center">

                        @* Lấy thông tin bàn từ Session *@
                        @{
                            var currentTableName = HttpContextAccessor.HttpContext.Session.GetString("CurrentTableName");
                        }

                        @* 1. Menu dùng chung *@
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-grid-3x3-gap-fill" style="font-size: 1.1rem; color: var(--cafe-primary);"></i> Sơ đồ bàn
                            </a>
                        </li>

                        @* HIỂN THỊ THÔNG TIN BÀN NẾU KHÁCH ĐÃ "ĐĂNG NHẬP" BÀN *@
                        @if (!string.IsNullOrEmpty(currentTableName))
                        {
                            <li class="nav-item d-flex align-items-center ms-lg-2">
                                <div class="table-info-badge my-1 my-lg-0">
                                    <i class="bi bi-geo-alt-fill animate-pulse" style="color: var(--danger-color);"></i> @currentTableName
                                </div>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link fw-bold" asp-controller="Client" asp-action="LeaveTable" style="color: var(--danger-color) !important;">
                                    <i class="bi bi-box-arrow-left"></i> Rời bàn
                                </a>
                            </li>
                        }

                        @* 2. Menu dành cho Admin và Nhân viên *@
                        @if (User.IsInRole("Admin") || User.IsInRole("Staff"))
                        {
                            <li class="nav-item border-start-lg ms-lg-3 ps-lg-3">
                                <a class="nav-link" asp-area="" asp-controller="Products" asp-action="Index">
                                    <i class="bi bi-journal-richtext" style="font-size: 1.1rem; color: var(--cafe-primary);"></i> Thực đơn
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="Categories" asp-action="Index">
                                    <i class="bi bi-tags-fill" style="font-size: 1.1rem; color: var(--cafe-primary);"></i> Loại món
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="Orders" asp-action="Index">
                                    <i class="bi bi-receipt-cutoff" style="font-size: 1.1rem; color: var(--cafe-primary);"></i> Quản lý hóa đơn
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link fw-bold" asp-area="" asp-controller="Kitchen" asp-action="Index" style="color: var(--cafe-accent) !important;">
                                    <i class="bi bi-cup-hot-fill" style="font-size: 1.1rem; color: var(--cafe-accent);"></i> Quầy bếp / Quầy bar ☕
                                </a>
                            </li>
                        }

                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item border-start-lg ms-lg-3 ps-lg-3">
                                <a class="nav-link fw-bold" asp-area="" asp-controller="AdminUsers" asp-action="Index" style="color: var(--cafe-accent) !important;">
                                    <i class="bi bi-people-fill" style="font-size: 1.1rem; color: var(--cafe-accent);"></i> Quản lý nhân viên
                                </a>
                            </li>
                        }

                        @* 3. Menu dành cho Khách có tài khoản Identity *@
                        @if (User.IsInRole("Customer"))
                        {
                            <li class="nav-item">
                                <a class="nav-link fw-bold" asp-area="" asp-controller="Home" asp-action="Index" style="color: var(--success-color) !important;">
                                    <i class="bi bi-stars" style="font-size: 1.1rem; color: var(--cafe-accent);"></i> Đặt món Online
                                </a>
                            </li>
                        }
                    </ul>

                    <!-- Theme Toggle Switch -->
                    <div class="theme-toggle-wrap ms-lg-3 my-2 my-lg-0 me-lg-2">
                        <button id="themeToggleBtn" class="btn btn-sm btn-pill btn-light border d-flex align-items-center justify-content-center" style="width: 42px; height: 42px; padding: 0;" title="Chuyển chế độ sáng/tối">
                            <i class="bi bi-sun-fill fs-5" id="themeToggleIcon" style="color: var(--cafe-secondary);"></i>
                        </button>
                    </div>

                    @* 4. Phần Đăng nhập/Đăng xuất của hệ thống *@
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>

    <div class="container main-container animate-fade-up">
        <main role="main" class="pb-5">
            @RenderBody()
        </main>
    </div>

    <!-- Toast Notification Container -->
    <div class="toast-container" id="toastContainer"></div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
        $(document).ready(function () {
            // Active nav highlight
            var currentUrl = window.location.pathname.toLowerCase();
            $('.navbar-nav .nav-link').each(function () {
                var linkUrl = $(this).attr('href');
                if (linkUrl) {
                    linkUrl = linkUrl.toLowerCase();
                    if (currentUrl === linkUrl || (currentUrl.startsWith(linkUrl) && linkUrl !== "/")) {
                        $(this).parent().addClass('active');
                    }
                }
            });

            // Scroll Progress Bar
            $(window).on('scroll', function() {
                var scrollTop = $(window).scrollTop();
                var docHeight = $(document).height() - $(window).height();
                var scrollPercent = docHeight > 0 ? (scrollTop / docHeight) * 100 : 0;
                $('#scrollProgress').css('width', scrollPercent + '%');
            });

            // Ripple Effect on all buttons
            $(document).on('click', '.btn', function(e) {
                var $btn = $(this);
                var ripple = $('<span class="ripple"></span>');
                var size = Math.max($btn.outerWidth(), $btn.outerHeight());
                ripple.css({
                    width: size, height: size,
                    left: e.pageX - $btn.offset().left - size / 2,
                    top: e.pageY - $btn.offset().top - size / 2
                });
                $btn.append(ripple);
                setTimeout(function() { ripple.remove(); }, 600);
            });

            // Theme Toggle Logic
            function updateThemeIcon(theme) {
                const icon = $('#themeToggleIcon');
                if (theme === 'light') {
                    icon.removeClass('bi-moon-stars-fill').addClass('bi-sun-fill').css('color', 'var(--cafe-secondary)');
                } else {
                    icon.removeClass('bi-sun-fill').addClass('bi-moon-stars-fill').css('color', 'var(--cafe-primary)');
                }
            }

            const currentTheme = localStorage.getItem('cafe-theme') || 'light';
            updateThemeIcon(currentTheme);

            $('#themeToggleBtn').on('click', function() {
                const activeTheme = document.documentElement.getAttribute('data-theme') || 'light';
                const newTheme = activeTheme === 'dark' ? 'light' : 'dark';
                
                document.documentElement.setAttribute('data-theme', newTheme);
                localStorage.setItem('cafe-theme', newTheme);
                updateThemeIcon(newTheme);

                showToast(newTheme === 'light' ? '🔆 Đã chuyển sang Giao diện Sáng Luxury' : '🌙 Đã chuyển sang Giao diện Tối Luxury', 'info');
            });
        });

        // Toast Notification Function
        function showToast(message, type) {
            type = type || 'default';
            var toast = $('<div class="toast-item toast-' + type + '">' +
                '<div style="font-weight:600;">' + message + '</div>' +
                '<div class="toast-progress"></div>' +
                '</div>');
            $('#toastContainer').append(toast);
            setTimeout(function() {
                toast.css('animation', 'toastSlideOut 0.4s forwards');
                setTimeout(function() { toast.remove(); }, 400);
            }, 4000);
        }
    </script>

    @if (User.IsInRole("Admin") || User.IsInRole("Staff"))
    {
        <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/6.0.1/signalr.min.js"></script>
        <script>
            // Audio synthesis helper (Ding-Dong / Bell)
            function playNotificationSound(type) {
                try {
                    var AudioContext = window.AudioContext || window.webkitAudioContext;
                    if (!AudioContext) return;
                    var ctx = new AudioContext();
                    if (type === 'bell') {
                        var osc = ctx.createOscillator();
                        var gain = ctx.createGain();
                        osc.type = 'triangle';
                        osc.frequency.setValueAtTime(987.77, ctx.currentTime); // B5
                        osc.connect(gain);
                        gain.connect(ctx.destination);
                        gain.gain.setValueAtTime(0.2, ctx.currentTime);
                        gain.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + 1.0);
                        osc.start();
                        osc.stop(ctx.currentTime + 1.0);
                    } else {
                        // Ding Dong
                        var osc1 = ctx.createOscillator();
                        var gain1 = ctx.createGain();
                        osc1.type = 'sine';
                        osc1.frequency.setValueAtTime(880, ctx.currentTime); // A5
                        osc1.connect(gain1);
                        gain1.connect(ctx.destination);
                        gain1.gain.setValueAtTime(0.2, ctx.currentTime);
                        gain1.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + 1.2);
                        osc1.start();
                        osc1.stop(ctx.currentTime + 1.2);
                        
                        setTimeout(function() {
                            try {
                                var osc2 = ctx.createOscillator();
                                var gain2 = ctx.createGain();
                                osc2.type = 'sine';
                                osc2.frequency.setValueAtTime(659.25, ctx.currentTime); // E5
                                osc2.connect(gain2);
                                gain2.connect(ctx.destination);
                                gain2.gain.setValueAtTime(0.15, ctx.currentTime);
                                gain2.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + 1.5);
                                osc2.start();
                                osc2.stop(ctx.currentTime + 1.5);
                            } catch(e) {}
                        }, 250);
                    }
                } catch(e) {
                    console.warn("Audio synthesis block: ", e);
                }
            }

            $(document).ready(function() {
                var adminConnection = new signalR.HubConnectionBuilder()
                    .withUrl("/notificationHub")
                    .withAutomaticReconnect()
                    .build();

                adminConnection.start().then(function () {
                    console.log("Admin SignalR Hub connected!");
                }).catch(function (err) {
                    console.error("Admin SignalR failed to start: ", err.toString());
                });

                // 1. Lắng nghe sự kiện gọi phục vụ
                adminConnection.on("ReceiveServiceCall", function(tableId, tableName) {
                    playNotificationSound('dingdong');
                    showPremiumToast("🔔 " + tableName.toUpperCase() + " đang gọi phục vụ! 🚨", "danger", tableId, "service");
                    
                    // Phát sự kiện jQuery để các view (như Home/Index.cshtml) nhận và xử lý nhấp nháy bàn
                    $(document).trigger("onServiceCall", [tableId, tableName]);
                });

                // 2. Lắng nghe sự kiện đơn đặt món mới
                adminConnection.on("ReceiveNewOrder", function(orderId, tableName) {
                    playNotificationSound('bell');
                    showPremiumToast("☕ ĐƠN MÓN MỚI! " + tableName + " vừa đặt món nước.", "warning", orderId, "order");
                    
                    $(document).trigger("onNewOrder", [orderId, tableName]);
                });

                // 3. Lắng nghe sự kiện nước sẵn sàng từ bếp
                adminConnection.on("ReceiveWaiterNotification", function(orderId, tableName) {
                    playNotificationSound('dingdong');
                    showPremiumToast("🍹 NƯỚC ĐÃ XONG! Món của " + tableName + " đã sẵn sàng. Mang ra phục vụ ngay! 🎉", "success", orderId, "ready");
                    
                    $(document).trigger("onWaiterNotification", [orderId, tableName]);
                });
                
                function showPremiumToast(message, type, targetId, category) {
                    var categoryText = "THÔNG BÁO";
                    var borderColor = "rgba(245, 166, 35, 0.5)";
                    var bgGlow = "rgba(245, 166, 35, 0.05)";
                    if (category === "service") { 
                        categoryText = "🚨 YÊU CẦU PHỤC VỤ"; 
                        borderColor = "#ef5350"; 
                        bgGlow = "rgba(239, 83, 80, 0.08)"; 
                    } else if (category === "order") { 
                        categoryText = "☕ ĐƠN MÓN MỚI"; 
                        borderColor = "#ffd54f"; 
                        bgGlow = "rgba(255, 213, 79, 0.08)"; 
                    } else if (category === "ready") { 
                        categoryText = "🍹 ĐÃ PHA CHẾ XONG"; 
                        borderColor = "#00e676"; 
                        bgGlow = "rgba(0, 230, 118, 0.08)"; 
                    }
                    
                    var toastId = "toast_" + Date.now();
                    var actionBtn = "";
                    
                    if (category === "service") {
                        actionBtn = '<button onclick="resolveServiceCall(' + targetId + ', \'' + toastId + '\')" class="btn btn-sm btn-pill btn-light py-1 px-3 mt-2 fw-bold text-danger border-0 shadow-sm" style="font-size:0.75rem;">Đã Xử Lý</button>';
                    }

                    var toast = $('<div id="' + toastId + '" class="toast-item toast-' + type + '" style="border-left: 5px solid ' + borderColor + '; background: rgba(22, 22, 22, 0.96); backdrop-filter: blur(15px); border-radius: 12px; box-shadow: 0 15px 40px rgba(0,0,0,0.5), inset 0 0 12px ' + bgGlow + '; padding: 16px; margin-bottom: 12px; width: 330px; transform: translateX(120%); transition: transform 0.35s cubic-bezier(0.175, 0.885, 0.32, 1.127); border-top: 1px solid rgba(255,255,255,0.05); border-right: 1px solid rgba(255,255,255,0.05); border-bottom: 1px solid rgba(255,255,255,0.05);">' +
                        '<div class="d-flex justify-content-between align-items-center mb-1"><span class="small fw-extrabold" style="color:' + borderColor + '; font-size:0.7rem; letter-spacing:1.2px; font-weight:800;">' + categoryText + '</span><button class="btn-close btn-close-white" style="font-size:0.65rem;" onclick="closePremiumToast(\'' + toastId + '\')"></button></div>' +
                        '<div style="font-weight:600; color:#fff; font-size:0.92rem; line-height:1.45;">' + message + '</div>' +
                        actionBtn +
                        '</div>');
                    
                    $('#toastContainer').append(toast);
                    
                    // Force reflow
                    toast[0].offsetHeight;
                    toast.css('transform', 'translateX(0)');

                    if (category !== "service") {
                        setTimeout(function() {
                            closePremiumToast(toastId);
                        }, 8000);
                    }
                }
            });

            function closePremiumToast(toastId) {
                var $t = $('#' + toastId);
                if ($t.length) {
                    $t.css('transform', 'translateX(120%)');
                    setTimeout(function() { $t.remove(); }, 350);
                }
            }

            function resolveServiceCall(tableId, toastId) {
                closePremiumToast(toastId);
                // Gửi sự kiện jQuery báo đã xử lý gọi phục vụ bàn này
                $(document).trigger("onResolveServiceCall", [tableId]);
            }
        </script>
    }

    <style>
        /* SVG Coffee Steam Animation */
        .steam-path {
            stroke-dasharray: 30;
            stroke-dashoffset: 30;
            animation: steamDraw 2.5s ease-in-out infinite;
        }
        .steam-path.s2 { animation-delay: 0.3s; }
        .steam-path.s3 { animation-delay: 0.6s; }

        @@keyframes steamDraw {
            0% { stroke-dashoffset: 30; opacity: 0; }
            30% { opacity: 0.7; }
            70% { opacity: 0.5; }
            100% { stroke-dashoffset: -30; opacity: 0; }
        }

        /* Animated Logo Text Shimmer */
        .logo-text {
            background: linear-gradient(90deg, var(--cafe-primary) 0%, var(--cafe-accent) 50%, var(--cafe-primary) 100%);
            background-size: 200% auto;
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            animation: logoShimmer 3s linear infinite;
        }
        @@keyframes logoShimmer {
            0% { background-position: 0% center; }
            100% { background-position: 200% center; }
        }

        .logo-icon-wrap {
            filter: drop-shadow(0 0 8px rgba(245, 166, 35, 0.3));
        }

        /* Sidebar accent bar */
        @@media (min-width: 992px) {
            .navbar-sidebar::before {
                content: "";
                position: absolute;
                top: 0;
                left: 0;
                width: 3px;
                height: 100%;
                background: linear-gradient(180deg, var(--cafe-primary), var(--cafe-secondary), transparent);
            }
        }
    </style>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>