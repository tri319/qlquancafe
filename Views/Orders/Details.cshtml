@model QLquancafe.Models.Order

@using Microsoft.AspNetCore.Http
@{
    ViewData["Title"] = "Chi tiết hóa đơn";
    Layout = Context.Session.GetInt32("CurrentTableId") != null ? "_CustomerLayout" : "_Layout";
}

<div class="row justify-content-center py-4 animate-fade-up">
    <div class="col-lg-8 col-md-10">
        
        @{
            // Determine active step level (1 to 4)
            int currentStep = 1;
            if (Model.IsPaid || Model.Status == "Completed")
            {
                currentStep = 4;
            }
            else if (Model.Status == "Ready")
            {
                currentStep = 3;
            }
            else if (Model.Status == "Preparing")
            {
                currentStep = 2;
            }
        }

        <!-- Live Order Tracker Section -->
        <div class="order-tracker-card p-4 mb-4 border rounded-3 text-center no-print" style="background: var(--cafe-surface); border-color: rgba(245, 166, 35, 0.15) !important; box-shadow: var(--shadow-soft); border-radius: var(--radius-md) !important;">
            <h5 class="fw-bold mb-3 d-flex align-items-center justify-content-center gap-2" style="color: var(--cafe-primary); font-size: 1.05rem; letter-spacing: 0.5px;">
                <span class="spinner-grow spinner-grow-sm text-warning" role="status" aria-hidden="true"></span>
                TIẾN ĐỘ ĐƠN HÀNG THỜI GIAN THỰC
            </h5>
            
            <div class="tracker-steps-wrapper position-relative d-flex justify-content-between align-items-center mt-4 mb-2" style="padding: 0 10px;">
                <!-- Progress Line Background -->
                <div class="tracker-progress-line position-absolute top-50 start-0 translate-middle-y w-100" style="height: 4px; background: var(--cafe-light); z-index: 1; margin-top: -14px;">
                    <div class="tracker-progress-line-fill h-100" id="trackerProgressFill" style="width: @((currentStep - 1) * 33.33)%; background: linear-gradient(90deg, var(--cafe-primary), var(--cafe-secondary)); transition: width 0.6s cubic-bezier(0.16, 1, 0.3, 1);"></div>
                </div>
                
                <!-- Step 1: Pending -->
                <div class="tracker-step d-flex flex-column align-items-center position-relative z-2" id="step-Pending">
                    <div class="tracker-icon-circle d-flex align-items-center justify-content-center rounded-circle @(currentStep >= 1 ? "active" : "") @(currentStep == 1 ? "current" : "")" style="width: 48px; height: 48px; border: 2px solid var(--cafe-light); background: var(--cafe-surface); color: var(--cafe-text-muted); transition: all 0.4s ease;">
                        <i class="bi bi-receipt fs-5"></i>
                    </div>
                    <span class="tracker-step-label fw-bold mt-2 small @(currentStep >= 1 ? "active-text" : "text-muted")" style="font-size: 0.78rem;">Đã Nhận Đơn</span>
                    <span class="tracker-step-icon-sub text-muted small mt-1" style="font-size: 0.65rem;">📥</span>
                </div>

                <!-- Step 2: Preparing -->
                <div class="tracker-step d-flex flex-column align-items-center position-relative z-2" id="step-Preparing">
                    <div class="tracker-icon-circle d-flex align-items-center justify-content-center rounded-circle @(currentStep >= 2 ? "active" : "") @(currentStep == 2 ? "current" : "")" style="width: 48px; height: 48px; border: 2px solid var(--cafe-light); background: var(--cafe-surface); color: var(--cafe-text-muted); transition: all 0.4s ease;">
                        <i class="bi bi-cup-hot fs-5"></i>
                    </div>
                    <span class="tracker-step-label fw-bold mt-2 small @(currentStep >= 2 ? "active-text" : "text-muted")" style="font-size: 0.78rem;">Đang Pha Chế</span>
                    <span class="tracker-step-icon-sub text-muted small mt-1" style="font-size: 0.65rem;">☕</span>
                </div>

                <!-- Step 3: Ready -->
                <div class="tracker-step d-flex flex-column align-items-center position-relative z-2" id="step-Ready">
                    <div class="tracker-icon-circle d-flex align-items-center justify-content-center rounded-circle @(currentStep >= 3 ? "active" : "") @(currentStep == 3 ? "current" : "")" style="width: 48px; height: 48px; border: 2px solid var(--cafe-light); background: var(--cafe-surface); color: var(--cafe-text-muted); transition: all 0.4s ease;">
                        <i class="bi bi-bell-fill fs-5"></i>
                    </div>
                    <span class="tracker-step-label fw-bold mt-2 small @(currentStep >= 3 ? "active-text" : "text-muted")" style="font-size: 0.78rem;">Sẵn Sàng</span>
                    <span class="tracker-step-icon-sub text-muted small mt-1" style="font-size: 0.65rem;">🚚</span>
                </div>

                <!-- Step 4: Completed -->
                <div class="tracker-step d-flex flex-column align-items-center position-relative z-2" id="step-Completed">
                    <div class="tracker-icon-circle d-flex align-items-center justify-content-center rounded-circle @(currentStep >= 4 ? "active" : "") @(currentStep == 4 ? "current" : "")" style="width: 48px; height: 48px; border: 2px solid var(--cafe-light); background: var(--cafe-surface); color: var(--cafe-text-muted); transition: all 0.4s ease;">
                        <i class="bi bi-star-fill fs-5"></i>
                    </div>
                    <span class="tracker-step-label fw-bold mt-2 small @(currentStep >= 4 ? "active-text" : "text-muted")" style="font-size: 0.78rem;">Hoàn Thành</span>
                    <span class="tracker-step-icon-sub text-muted small mt-1" style="font-size: 0.65rem;">🌟</span>
                </div>
            </div>
        </div>

        <!-- Thermal Receipt Container -->
        <div class="thermal-receipt p-4 p-md-5">
            
            <!-- Receipt Header -->
            <div class="text-center mb-4">
                <div class="brand-receipt-icon mb-2">
                    <i class="bi bi-cup-hot-fill fs-1 text-warning"></i>
                </div>
                <h2 class="fw-extrabold text-uppercase tracking-wide" style="color: var(--cafe-primary); font-weight: 800;">
                    HÓA ĐƠN THANH TOÁN
                </h2>
                <p class="text-muted mb-0 font-monospace">Mã đơn: #@Model.Id</p>
                <div class="d-flex justify-content-center gap-2 mt-2">
                    <span class="badge bg-primary rounded-pill px-3">Bàn @Model.TableNumber</span>
                </div>
            </div>

            <div class="receipt-divider"></div>

            <!-- Receipt Metadata -->
            <div class="row mb-4 fs-6">
                <div class="col-6 mb-2">
                    <span class="d-block text-muted small text-uppercase font-monospace">Ngày Bán</span>
                    <strong class="text-dark"><i class="bi bi-calendar-event me-1"></i> @Model.OrderDate.ToString("dd/MM/yyyy HH:mm")</strong>
                </div>
                <div class="col-6 mb-2 text-end">
                    <span class="d-block text-muted small text-uppercase font-monospace">Trạng Thái</span>
                    @if (Model.IsPaid)
                    {
                        <span class="text-success fw-bold d-inline-flex align-items-center gap-1">
                            <i class="bi bi-check-circle-fill"></i> ĐÃ THANH TOÁN
                        </span>
                    }
                    else
                    {
                        <span class="text-danger fw-bold d-inline-flex align-items-center gap-1 animate-pulse">
                            <i class="bi bi-clock-history"></i> CHỜ THANH TOÁN
                        </span>
                    }
                </div>
            </div>

            <!-- Receipt Table -->
            <div class="table-responsive mb-4">
                <table class="table table-borderless align-middle receipt-table">
                    <thead class="border-bottom border-top border-dark-subtle font-monospace" style="font-size: 0.8rem; background-color: var(--cafe-light);">
                        <tr>
                            <th class="py-2">Tên món</th>
                            <th class="text-center py-2">SL</th>
                            <th class="text-end py-2">Đơn giá</th>
                            <th class="text-end py-2">Thành tiền</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var detail in Model.OrderDetails)
                        {
                            <tr class="border-bottom border-light-subtle">
                                <td class="py-3">
                                    <div class="fw-bold text-dark">
                                        @detail.Product?.Name
                                        @if (!string.IsNullOrEmpty(detail.Size))
                                        {
                                            <span class="badge bg-primary ms-1" style="font-size: 0.7rem; padding: 0.25em 0.5em;">Size @detail.Size</span>
                                        }
                                    </div>
                                    @if (!string.IsNullOrEmpty(detail.SugarLevel) || !string.IsNullOrEmpty(detail.IceLevel))
                                    {
                                        <div class="small text-muted mt-1 d-flex flex-wrap gap-1" style="font-size: 0.75rem;">
                                            @if (!string.IsNullOrEmpty(detail.SugarLevel)) { <span class="badge bg-light text-dark border">Đường: @detail.SugarLevel</span> }
                                            @if (!string.IsNullOrEmpty(detail.IceLevel)) { <span class="badge bg-light text-dark border">Đá: @detail.IceLevel</span> }
                                        </div>
                                    }
                                </td>
                                <td class="text-center fw-bold">@detail.Quantity</td>
                                <td class="text-end text-muted font-monospace">@detail.UnitPrice.ToString("N0")</td>
                                <td class="text-end fw-bold text-dark font-monospace">@((detail.Quantity * detail.UnitPrice).ToString("N0"))</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Receipt Summary Footer -->
            <div class="row mt-4">
                <div class="col-md-7 mb-3 mb-md-0">
                    @if (Model.IsPaid)
                    {
                        <div class="alert alert-success d-inline-flex align-items-center gap-2 border-0 bg-success-subtle text-success py-2 px-3 rounded-pill mb-0" style="font-size: 0.85rem;">
                            <i class="bi bi-info-circle-fill"></i> Bàn này đã được phục vụ xong và dọn trống.
                        </div>
                    }
                </div>
                <div class="col-md-5">
                    @if (Model.DiscountAmount > 0)
                    {
                        <div class="d-flex justify-content-between align-items-center mb-1 small text-muted">
                            <span>Tạm tính món</span>
                            <span class="font-monospace">@((Model.TotalAmount + Model.DiscountAmount).ToString("N0")) đ</span>
                        </div>
                        <div class="d-flex justify-content-between align-items-center mb-2 small text-success">
                            <span>Giảm giá thành viên</span>
                            <span class="font-monospace">-@Model.DiscountAmount.ToString("N0") đ</span>
                        </div>
                    }
                    <div class="receipt-total-box d-flex justify-content-between align-items-center p-3 mb-2">
                        <span class="fw-bold text-uppercase text-muted" style="font-size: 0.85rem; letter-spacing: 1px;">TỔNG CỘNG</span>
                        <h4 class="text-danger fw-extrabold mb-0 fs-3 font-monospace">@Model.TotalAmount.ToString("N0") đ</h4>
                    </div>
                    @if (Model.PointsEarned > 0)
                    {
                        <div class="text-end small text-muted">
                            <span class="badge bg-success-subtle text-success border px-3 py-1 rounded-pill">
                                <i class="bi bi-stars"></i> Tích lũy nhận được: +@Model.PointsEarned điểm
                            </span>
                        </div>
                    }
                </div>
            </div>

            <div class="receipt-divider no-print"></div>

            <!-- Business Operations CTA Buttons -->
            <div class="mt-4 no-print text-center d-flex flex-wrap justify-content-center gap-2">
                @if (!Model.IsPaid)
                {
                    if (Context.Session.GetInt32("CurrentTableId") == null)
                    {
                        <form asp-action="Pay" method="post" class="d-inline">
                            <input type="hidden" name="id" value="@Model.Id" />
                            <button type="submit" class="btn btn-success btn-pill px-4 shadow">
                                <i class="bi bi-cash-stack"></i> TIỀN MẶT
                            </button>
                        </form>
                        
                        <a asp-controller="Payment" asp-action="CreatePaymentUrl" asp-route-orderId="@Model.Id" class="btn btn-cafe btn-pill px-4 shadow">
                            <i class="bi bi-credit-card-2-front"></i> THANH TOÁN VNPAY
                        </a>
                    }
                    else
                    {
                        <a asp-controller="Payment" asp-action="CreatePaymentUrl" asp-route-orderId="@Model.Id" class="btn btn-cafe btn-pill px-4 shadow">
                            <i class="bi bi-credit-card-2-front"></i> TỰ THANH TOÁN VNPAY
                        </a>
                        <button type="button" class="btn btn-outline-warning btn-pill px-4 shadow" id="call-staff-cash-btn">
                            <i class="bi bi-cash-stack"></i> Thanh toán tiền mặt
                        </button>
                    }
                }

                <button onclick="window.print()" class="btn btn-outline-primary btn-pill px-4">
                    <i class="bi bi-printer"></i> In Hóa Đơn
                </button>

                @if (!Model.IsPaid)
                {
                    <a asp-controller="Orders" asp-action="Create" asp-route-tableId="@Model.TableId" class="btn btn-outline-secondary btn-pill px-4">
                        <i class="bi bi-cart-plus"></i> Gọi thêm món
                    </a>
                }

                @if (Context.Session.GetInt32("CurrentTableId") == null)
                {
                    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-dark btn-pill px-4">
                        <i class="bi bi-arrow-left"></i> Quay lại sơ đồ
                    </a>
                }
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .brand-receipt-icon {
            display: inline-flex;
            width: 70px;
            height: 70px;
            align-items: center;
            justify-content: center;
            background-color: var(--cafe-light);
            border-radius: 50%;
            border: 2px dashed rgba(62, 39, 35, 0.15);
        }

        /* Live Tracker Custom Styles */
        .tracker-icon-circle {
            position: relative;
            z-index: 2;
            background-color: var(--cafe-surface) !important;
        }

        .tracker-icon-circle.active {
            border-color: var(--cafe-primary) !important;
            background: linear-gradient(135deg, var(--cafe-primary) 0%, var(--cafe-secondary) 100%) !important;
            color: #FFFFFF !important;
            box-shadow: 0 4px 12px rgba(245, 166, 35, 0.35);
        }

        .tracker-icon-circle.current {
            animation: trackerPulse 2.0s infinite ease-in-out;
            border-color: var(--cafe-secondary) !important;
            box-shadow: 0 0 0 4px rgba(230, 90, 40, 0.25), 0 4px 12px rgba(230, 90, 40, 0.4);
        }

        .active-text {
            color: var(--cafe-primary) !important;
            text-shadow: 0 0 10px rgba(245, 166, 35, 0.15);
        }

        @@keyframes trackerPulse {
            0% {
                box-shadow: 0 0 0 0px rgba(230, 90, 40, 0.4), 0 4px 10px rgba(230, 90, 40, 0.3);
            }
            70% {
                box-shadow: 0 0 0 6px rgba(230, 90, 40, 0), 0 4px 10px rgba(230, 90, 40, 0.3);
            }
            100% {
                box-shadow: 0 0 0 0px rgba(230, 90, 40, 0), 0 4px 10px rgba(230, 90, 40, 0.3);
            }
        }

        /* Responsive tracker typography */
        @@media (max-width: 576px) {
            .tracker-step-label {
                font-size: 0.65rem !important;
            }
            .tracker-icon-circle {
                width: 38px !important;
                height: 38px !important;
            }
            .tracker-icon-circle i {
                font-size: 0.9rem !important;
            }
            .tracker-progress-line {
                margin-top: -16px !important;
            }
        }

        .receipt-table th, .receipt-table td {
            font-size: 0.95rem;
        }

        @@media print {
            body {
                background-color: #FFFFFF !important;
                color: #000000 !important;
            }
            .no-print, header, footer, .navbar, .btn {
                display: none !important;
            }
            .main-container {
                padding-top: 0 !important;
                margin: 0 !important;
            }
            .thermal-receipt {
                border: none !important;
                box-shadow: none !important;
                padding: 0 !important;
                background: #FFFFFF !important;
            }
            .thermal-receipt::before {
                display: none !important;
            }
            .col-lg-8 {
                width: 100% !important;
                max-width: 100% !important;
            }
        }
    </style>
}

@section Scripts {
    <!-- Tích hợp thư viện SignalR Client của Microsoft thông qua CDN để kích hoạt giao tiếp hai chiều thời gian thực -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/6.0.1/signalr.min.js"></script>
    <script>
        function updateTrackerUI(status) {
            var stepLevel = 1;
            if (status === "Preparing") stepLevel = 2;
            else if (status === "Ready") stepLevel = 3;
            else if (status === "Completed") stepLevel = 4;

            // Cập nhật thanh tiến trình chạy ngang
            var fillPercent = (stepLevel - 1) * 33.33;
            $("#trackerProgressFill").css("width", fillPercent + "%");

            // Reset tất cả các vòng tròn
            $(".tracker-icon-circle").removeClass("active current");
            $(".tracker-step-label").removeClass("active-text").addClass("text-muted");

            // Kích hoạt các vòng tròn tương ứng với mức tiến độ
            var steps = ["Pending", "Preparing", "Ready", "Completed"];
            for (var i = 0; i < steps.length; i++) {
                var idx = i + 1;
                var stepName = steps[i];
                var $circle = $("#step-" + stepName + " .tracker-icon-circle");
                var $label = $("#step-" + stepName + " .tracker-step-label");

                if (idx <= stepLevel) {
                    $circle.addClass("active");
                    $label.addClass("active-text").removeClass("text-muted");
                }
                if (idx === stepLevel) {
                    $circle.addClass("current");
                }
            }
        }

        $(document).ready(function() {
            // [XỬ LÝ GỌI NHÂN VIÊN] Khi khách hàng bấm nút "Thanh toán tiền mặt" tại bàn
            // Hệ thống sẽ tự động kích hoạt sự kiện bấm nút gọi phục vụ chung trên thanh điều hướng của khách hàng
            $("#call-staff-cash-btn").click(function() {
                $("#call-staff-btn").click();
            });

            // [KHỞI TẠO SIGNALR] Cấu hình và mở cổng kết nối WebSockets tới NotificationHub trên máy chủ
            // Sử dụng cơ chế tự động kết nối lại (.withAutomaticReconnect) khi gặp sự cố mạng đột ngột
            var connection = new signalR.HubConnectionBuilder()
                .withUrl("/notificationHub")
                .withAutomaticReconnect()
                .build();

            // Bắt đầu mở cổng kết nối thời gian thực
            connection.start().then(function () {
                console.log("Details page SignalR connected successfully!");
            }).catch(function (err) {
                console.error("SignalR connection fail in Details page: ", err.toString());
            });

            // [ĐỒNG BỘ TRẠNG THÁI PHA CHẾ] Lắng nghe sự kiện "ReceiveOrderStatusUpdate" từ máy chủ
            connection.on("ReceiveOrderStatusUpdate", function(orderId, status) {
                var currentOrderId = @Model.Id;
                if (orderId === currentOrderId) {
                    updateTrackerUI(status);
                    
                    var statusVi = "Đã nhận đơn 📥";
                    if (status === "Preparing") statusVi = "Đang pha chế ☕";
                    else if (status === "Ready") statusVi = "Sẵn sàng phục vụ 🚚";
                    else if (status === "Completed") statusVi = "Hoàn thành đơn hàng 🌟";

                    if (typeof showToast === "function") {
                        showToast("☕ Đơn hàng đã chuyển sang trạng thái: <strong>" + statusVi + "</strong>", "info");
                    } else {
                        console.log("Status update: " + statusVi);
                    }
                }
            });

            // [ĐỒNG BỘ THANH TOÁN] Lắng nghe sự kiện "ReceiveOrderPaid" phát ra từ phía máy chủ
            // Kích hoạt khi nhân viên xác nhận thanh toán tiền mặt thành công hoặc nhận callback thành công từ VNPAY
            connection.on("ReceiveOrderPaid", function(orderId) {
                var currentOrderId = @Model.Id;
                // Kiểm tra xem hóa đơn vừa được thanh toán thành công có trùng khớp với hóa đơn khách hàng đang xem hay không
                if (orderId === currentOrderId) {
                    updateTrackerUI("Completed");
                    // Nếu hệ thống hỗ trợ phương thức hiển thị thông báo Toast đẹp mắt, hãy hiển thị Toast
                    if (typeof showToast === "function") {
                        showToast("🎉 Hóa đơn đã được thanh toán thành công! Hệ thống đang tự động tải lại...", "success");
                    } else {
                        // Phương thức dự phòng khi không tìm thấy hàm Toast
                        alert("🎉 Hóa đơn đã được thanh toán thành công!");
                    }

                    // Thiết lập bộ hẹn giờ trì hoãn 1.5 giây để khách hàng kịp xem thông báo chúc mừng, sau đó tự động reload trang
                    setTimeout(function() {
                        location.reload();
                    }, 1500);
                }
            });
        });
    </script>
}