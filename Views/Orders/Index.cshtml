@model IEnumerable<QLquancafe.Models.Order>

@{
    ViewData["Title"] = "Thống kê doanh thu & Hóa đơn";
    var filter = ViewBag.CurrentFilter as string ?? "today";
}

<!-- Dashboard Filter Header -->
<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-5 animate-fade-up">
    <div>
        <span class="text-uppercase tracking-wider text-muted fw-bold" style="font-size: 0.75rem; letter-spacing: 1.5px;">Trang Quản Trị</span>
        <h2 class="fw-extrabold mb-0" style="color: var(--cafe-primary); font-weight: 800;">
            <i class="bi bi-graph-up-arrow me-2" style="color: var(--cafe-secondary);"></i> THỐNG KÊ DOANH THU
        </h2>
    </div>
    
    <form method="get" asp-action="Index" class="d-flex align-items-center bg-white p-2 rounded-pill shadow-sm border" style="border-color: rgba(141, 110, 99, 0.15);">
        <label class="me-2 ms-3 fw-bold text-muted small text-uppercase font-monospace" style="letter-spacing: 0.5px;">Khoảng thời gian:</label>
        <select name="filter" class="form-select border-0 bg-transparent fw-bold cursor-pointer shadow-none py-1 pe-4" onchange="this.form.submit()" style="min-width: 140px; color: var(--cafe-primary); font-size: 0.9rem;">
            @if (filter == "today") { <option value="today" selected>Hôm nay</option> } else { <option value="today">Hôm nay</option> }
            @if (filter == "week") { <option value="week" selected>Tuần này</option> } else { <option value="week">Tuần này</option> }
            @if (filter == "month") { <option value="month" selected>Tháng này</option> } else { <option value="month">Tháng này</option> }
            @if (filter == "all") { <option value="all" selected>Tất cả</option> } else { <option value="all">Tất cả</option> }
        </select>
    </form>
</div>

<!-- Premium Dashboard Cards -->
<div class="row g-4 mb-5 animate-fade-up" style="animation-delay: 0.1s;">
    <!-- Revenue Card -->
    <div class="col-md-4">
        <div class="card border-0 text-white h-100 card-hover dashboard-stat-card bg-emerald">
            <div class="card-body p-4 d-flex align-items-center justify-content-between position-relative overflow-hidden">
                <div>
                    <span class="mb-1 text-uppercase fw-bold text-white-50 font-monospace" style="letter-spacing: 1px; font-size: 0.75rem;">Tổng Doanh Thu</span>
                    <h3 class="mb-0 fw-extrabold fs-2 tracking-wide font-monospace">@((ViewBag.TotalRevenue ?? 0).ToString("N0")) đ</h3>
                </div>
                <div class="stat-icon-wrapper">
                    <i class="bi bi-cash-stack"></i>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Completed Orders Card -->
    <div class="col-md-4">
        <div class="card border-0 text-white h-100 card-hover dashboard-stat-card bg-latte">
            <div class="card-body p-4 d-flex align-items-center justify-content-between position-relative overflow-hidden">
                <div>
                    <span class="mb-1 text-uppercase fw-bold text-white-50 font-monospace" style="letter-spacing: 1px; font-size: 0.75rem;">Đã Thanh Toán</span>
                    <h3 class="mb-0 fw-extrabold fs-2 font-monospace">@ViewBag.CompletedOrdersCount Hóa đơn</h3>
                </div>
                <div class="stat-icon-wrapper">
                    <i class="bi bi-patch-check-fill"></i>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Pending Orders Card -->
    <div class="col-md-4">
        <div class="card border-0 text-white h-100 card-hover dashboard-stat-card bg-sunset">
            <div class="card-body p-4 d-flex align-items-center justify-content-between position-relative overflow-hidden">
                <div>
                    <span class="mb-1 text-uppercase fw-bold text-white-50 font-monospace" style="letter-spacing: 1px; font-size: 0.75rem;">Chờ Thu Tiền</span>
                    <h3 class="mb-0 fw-extrabold fs-2 font-monospace">@ViewBag.PendingOrdersCount Hóa đơn</h3>
                </div>
                <div class="stat-icon-wrapper">
                    <i class="bi bi-hourglass-split"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modern Glass Data Table -->
<div class="card border-0 glass-panel animate-fade-up" style="animation-delay: 0.2s;">
    <div class="card-header bg-transparent d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-2 p-4 border-bottom border-light-subtle">
        <div>
            <h5 class="mb-0 fw-bold" style="color: var(--cafe-primary);"><i class="bi bi-list-ul me-2"></i> LỊCH SỬ GIAO DỊCH</h5>
        </div>
        <span class="badge bg-light text-dark px-3 py-2 rounded-pill border fw-bold text-capitalize" style="font-size: 0.8rem;">
            Bộ lọc: @(filter == "today" ? "Hôm nay" : filter == "week" ? "Tuần này" : filter == "month" ? "Tháng này" : "Tất cả")
        </span>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0 align-middle">
                <thead>
                    <tr>
                        <th class="ps-4">Mã HD</th>
                        <th>Bàn</th>
                        <th>Thời Gian</th>
                        <th class="text-end">Tổng Tiền</th>
                        <th class="text-center">Trạng Thái</th>
                        <th class="text-center pe-4">Thao Tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted py-5">
                                <div class="py-5">
                                    <i class="bi bi-inbox text-light display-1"></i>
                                    <p class="mt-3 mb-0 fs-5 fw-bold">Không tìm thấy hóa đơn nào trong kỳ này.</p>
                                </div>
                            </td>
                        </tr>
                    }
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4">
                                <span class="font-monospace fw-bold text-muted">#@item.Id</span>
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border rounded-pill px-3 font-monospace fw-bold">Bàn @item.TableNumber</span>
                            </td>
                            <td>
                                <span class="text-muted small"><i class="bi bi-calendar-event me-1"></i> @item.OrderDate.ToString("dd/MM/yyyy HH:mm")</span>
                            </td>
                            <td class="text-end text-danger fw-extrabold fs-5 font-monospace">
                                @item.TotalAmount.ToString("N0") đ
                            </td>
                            <td class="text-center">
                                @if (item.IsPaid)
                                {
                                    <span class="badge bg-success-subtle text-success px-3 py-2 rounded-pill font-semibold">
                                        <i class="bi bi-check-circle-fill me-1"></i> Đã thanh toán
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger-subtle text-danger px-3 py-2 rounded-pill font-semibold animate-pulse">
                                        <i class="bi bi-clock-history me-1"></i> Chờ thanh toán
                                    </span>
                                }
                            </td>
                            <td class="text-center pe-4">
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-light btn-pill border px-3 fw-bold">
                                    Chi tiết <i class="bi bi-arrow-right-short fs-5"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .dashboard-stat-card {
            border-radius: var(--radius-lg);
            position: relative;
        }

        .bg-emerald {
            background: linear-gradient(135deg, #1B5E20 0%, #4CAF50 100%);
            box-shadow: 0 10px 25px rgba(27, 94, 32, 0.22);
        }
        
        .bg-latte {
            background: linear-gradient(135deg, #3E2723 0%, #8D6E63 100%);
            box-shadow: 0 10px 25px rgba(62, 39, 35, 0.22);
        }
        
        .bg-sunset {
            background: linear-gradient(135deg, #B71C1C 0%, #E57373 100%);
            box-shadow: 0 10px 25px rgba(183, 28, 28, 0.22);
        }

        .stat-icon-wrapper {
            font-size: 3.5rem;
            opacity: 0.18;
            transform: rotate(8deg) translateY(5px);
            transition: all 0.3s ease;
        }
        .dashboard-stat-card:hover .stat-icon-wrapper {
            opacity: 0.32;
            transform: rotate(0deg) scale(1.08);
        }
    </style>
}