@model IEnumerable<QLquancafe.Models.Order>

@{
    ViewData["Title"] = "Thống kê doanh thu & Hóa đơn";
    var filter = ViewBag.CurrentFilter as string ?? "today";
}

<!-- Dashboard Filter Header -->
<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-5 stagger-item" style="--i: 1;">
    <div>
        <span class="text-uppercase tracking-wider text-muted fw-bold" style="font-size: 0.75rem; letter-spacing: 1.5px;">Trang Quản Trị</span>
        <h2 class="fw-extrabold mb-0 typewriter-text" style="color: var(--cafe-primary); font-weight: 800;">
            <i class="bi bi-graph-up-arrow me-2" style="color: var(--cafe-secondary);"></i> DOANH THU
        </h2>
    </div>
    
    <form method="get" asp-action="Index" class="d-flex align-items-center bg-dark p-2 rounded-pill shadow-sm border" style="border-color: rgba(245, 166, 35, 0.15); background: var(--cafe-surface) !important;">
        <label class="me-2 ms-3 fw-bold text-muted small text-uppercase font-monospace" style="letter-spacing: 0.5px;">Khoảng thời gian:</label>
        <select name="filter" class="form-select border-0 bg-transparent fw-bold cursor-pointer shadow-none py-1 pe-4 text-primary" onchange="this.form.submit()" style="min-width: 140px; font-size: 0.9rem;">
            @if (filter == "today") { <option value="today" selected>Hôm nay</option> } else { <option value="today">Hôm nay</option> }
            @if (filter == "week") { <option value="week" selected>Tuần này</option> } else { <option value="week">Tuần này</option> }
            @if (filter == "month") { <option value="month" selected>Tháng này</option> } else { <option value="month">Tháng này</option> }
            @if (filter == "all") { <option value="all" selected>Tất cả</option> } else { <option value="all">Tất cả</option> }
        </select>
    </form>
</div>

<!-- Premium Dashboard Cards -->
<div class="row g-4 mb-5">
    <!-- Revenue Card -->
    <div class="col-md-4 stagger-item" style="--i: 2;">
        <div class="card border-0 h-100 card-hover dashboard-stat-card bg-emerald gradient-border-card">
            <div class="card-body p-4 d-flex align-items-center justify-content-between position-relative overflow-hidden" style="z-index: 2;">
                <div class="w-100">
                    <span class="mb-1 text-uppercase fw-bold text-muted font-monospace" style="letter-spacing: 1px; font-size: 0.75rem;">Tổng Doanh Thu</span>
                    <h3 class="mb-2 fw-extrabold fs-2 tracking-wide font-monospace animated-counter" data-target="@(ViewBag.TotalRevenue ?? 0)">0</h3>
                    <div class="d-flex flex-wrap gap-2 pt-2 border-top" style="border-color: var(--card-border) !important;">
                        <span class="badge bg-success-subtle text-success d-flex align-items-center gap-1 font-monospace" style="font-size: 0.72rem; background: rgba(0, 230, 118, 0.15) !important; padding: 0.4em 0.7em;">
                            <i class="bi bi-cash"></i> TM: @(((decimal)(ViewBag.CashRevenue ?? 0m)).ToString("N0")) đ
                        </span>
                        <span class="badge bg-info-subtle text-info d-flex align-items-center gap-1 font-monospace" style="font-size: 0.72rem; background: rgba(0, 184, 212, 0.15) !important; padding: 0.4em 0.7em;">
                            <i class="bi bi-credit-card"></i> VNPay: @(((decimal)(ViewBag.VnPayRevenue ?? 0m)).ToString("N0")) đ
                        </span>
                    </div>
                </div>
                <div class="stat-icon-wrapper ms-3">
                    <i class="bi bi-cash-stack"></i>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Completed Orders Card -->
    <div class="col-md-4 stagger-item" style="--i: 3;">
        <div class="card border-0 h-100 card-hover dashboard-stat-card bg-latte gradient-border-card" style="--border-angle: 90deg;">
            <div class="card-body p-4 d-flex align-items-center justify-content-between position-relative overflow-hidden" style="z-index: 2;">
                <div>
                    <span class="mb-1 text-uppercase fw-bold text-muted font-monospace" style="letter-spacing: 1px; font-size: 0.75rem;">Đã Thanh Toán</span>
                    <h3 class="mb-0 fw-extrabold fs-2 font-monospace">
                        <span class="animated-counter" data-target="@ViewBag.CompletedOrdersCount" data-is-currency="false">0</span>
                    </h3>
                </div>
                <div class="stat-icon-wrapper">
                    <i class="bi bi-patch-check-fill"></i>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Pending Orders Card -->
    <div class="col-md-4 stagger-item" style="--i: 4;">
        <div class="card border-0 h-100 card-hover dashboard-stat-card bg-sunset gradient-border-card" style="--border-angle: 180deg;">
            <div class="card-body p-4 d-flex align-items-center justify-content-between position-relative overflow-hidden" style="z-index: 2;">
                <div>
                    <span class="mb-1 text-uppercase fw-bold text-muted font-monospace" style="letter-spacing: 1px; font-size: 0.75rem;">Chờ Thu Tiền</span>
                    <h3 class="mb-0 fw-extrabold fs-2 font-monospace">
                        <span class="animated-counter" data-target="@ViewBag.PendingOrdersCount" data-is-currency="false">0</span>
                    </h3>
                </div>
                <div class="stat-icon-wrapper">
                    <i class="bi bi-hourglass-split"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Charts Dashboard Row -->
<div class="row mb-5 stagger-item" style="--i: 4.5;">
    <!-- Line Chart (Revenue Trend) -->
    <div class="col-lg-8 mb-4 mb-lg-0">
        <div class="card border-0 glass-panel h-100">
            <div class="card-header bg-transparent d-flex justify-content-between align-items-center p-4 border-bottom border-light-subtle">
                <h5 class="mb-0 fw-bold" style="color: var(--cafe-primary);">
                    <i class="bi bi-activity me-2" style="color: var(--cafe-secondary);"></i>
                    Xu Hướng Doanh Thu
                </h5>
                <span class="badge bg-warning-subtle text-warning px-3 py-1 rounded-pill border fw-bold text-uppercase" style="font-size: 0.75rem; letter-spacing: 0.5px;">
                    Biểu đồ đường mịn
                </span>
            </div>
            <div class="card-body p-4 position-relative">
                <div id="revenueLineChart" style="min-height: 350px;"></div>
            </div>
        </div>
    </div>

    <!-- Donut Chart (Best Sellers) -->
    <div class="col-lg-4">
        <div class="card border-0 glass-panel h-100">
            <div class="card-header bg-transparent d-flex justify-content-between align-items-center p-4 border-bottom border-light-subtle">
                <h5 class="mb-0 fw-bold" style="color: var(--cafe-primary);">
                    <i class="bi bi-pie-chart me-2" style="color: var(--cafe-secondary);"></i>
                    Top Món Bán Chạy
                </h5>
                <span class="badge bg-success-subtle text-success px-3 py-1 rounded-pill border fw-bold text-uppercase" style="font-size: 0.75rem; letter-spacing: 0.5px;">
                    Top 5
                </span>
            </div>
            <div class="card-body p-4 d-flex align-items-center justify-content-center">
                <div id="bestSellersDonutChart" class="w-100" style="min-height: 330px;"></div>
            </div>
        </div>
    </div>
</div>

<!-- Modern Glass Data Table -->
<div class="card border-0 glass-panel stagger-item" style="--i: 5;">
    <div class="card-header bg-transparent d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-2 p-4 border-bottom border-light-subtle">
        <div>
            <h5 class="mb-0 fw-bold" style="color: var(--cafe-primary);"><i class="bi bi-list-ul me-2"></i> LỊCH SỬ GIAO DỊCH</h5>
        </div>
        <span class="badge bg-secondary-subtle text-muted px-3 py-2 rounded-pill border fw-bold text-capitalize" style="font-size: 0.8rem;">
            Bộ lọc: @(filter == "today" ? "Hôm nay" : filter == "week" ? "Tuần này" : filter == "month" ? "Tháng này" : "Tất cả")
        </span>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0 align-middle">
                <thead>
                    <tr>
                        <th class="ps-4">Mã HD</th>
                        <th>Bàn</th>
                        <th>Thời Gian</th>
                        <th class="text-end">Tổng Tiền</th>
                        <th class="text-center">Trạng Thái</th>
                        <th class="text-center pe-4">Thao Tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted py-5">
                                <div class="py-5">
                                    <i class="bi bi-inbox text-muted display-1"></i>
                                    <p class="mt-3 mb-0 fs-5 fw-bold">Không tìm thấy hóa đơn nào trong kỳ này.</p>
                                </div>
                            </td>
                        </tr>
                    }
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4">
                                <span class="font-monospace fw-bold text-muted">#@item.Id</span>
                            </td>
                            <td>
                                <span class="badge bg-light text-primary border rounded-pill px-3 font-monospace fw-bold">Bàn @item.TableNumber</span>
                            </td>
                            <td>
                                <span class="text-muted small"><i class="bi bi-calendar-event me-1"></i> @item.OrderDate.ToString("dd/MM/yyyy HH:mm")</span>
                            </td>
                            <td class="text-end text-danger fw-extrabold fs-5 font-monospace">
                                @item.TotalAmount.ToString("N0") đ
                            </td>
                            <td class="text-center">
                                @if (item.IsPaid)
                                {
                                    <span class="badge bg-success-subtle text-success px-3 py-2 rounded-pill font-semibold">
                                        <i class="bi bi-check-circle-fill me-1"></i> Đã thanh toán
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger-subtle text-danger px-3 py-2 rounded-pill font-semibold animate-pulse" style="box-shadow: 0 0 10px rgba(255,82,82,0.3) !important;">
                                        <i class="bi bi-clock-history me-1"></i> Chờ thanh toán
                                    </span>
                                }
                            </td>
                            <td class="text-center pe-4">
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary btn-pill px-3 fw-bold magnetic-btn">
                                    Chi tiết <i class="bi bi-arrow-right-short fs-5"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/apexcharts"></script>
    <script>
        $(document).ready(function() {
            // Setup ApexCharts
            try {
                // Parse the serialized data
                const chartLabels = JSON.parse('@Html.Raw(ViewBag.ChartLabelsJson)');
                const chartValues = JSON.parse('@Html.Raw(ViewBag.ChartValuesJson)');

                // Setup Revenue Area Chart
                const revenueOptions = {
                    series: [{
                        name: 'Doanh thu',
                        data: chartValues
                    }],
                    chart: {
                        type: 'area',
                        height: 350,
                        toolbar: { show: false },
                        background: 'transparent',
                        foreColor: '#8A8A8A',
                        zoom: { enabled: false }
                    },
                    colors: ['#F5A623'],
                    fill: {
                        type: 'gradient',
                        gradient: {
                            shadeIntensity: 1,
                            opacityFrom: 0.45,
                            opacityTo: 0.05,
                            stops: [0, 90, 100]
                        }
                    },
                    dataLabels: { enabled: false },
                    stroke: {
                        curve: 'smooth',
                        width: 3
                    },
                    theme: { mode: 'dark' },
                    grid: {
                        borderColor: 'rgba(245, 166, 35, 0.05)',
                        strokeDashArray: 4
                    },
                    xaxis: {
                        categories: chartLabels,
                        axisBorder: { show: false },
                        axisTicks: { show: false }
                    },
                    yaxis: {
                        labels: {
                            formatter: function (value) {
                                return value.toLocaleString('vi-VN') + ' đ';
                            }
                        }
                    },
                    tooltip: {
                        theme: 'dark',
                        y: {
                            formatter: function (value) {
                                return value.toLocaleString('vi-VN') + ' đ';
                            }
                        }
                    }
                };

                const revenueChart = new ApexCharts(document.querySelector("#revenueLineChart"), revenueOptions);
                revenueChart.render();
            } catch (err) {
                console.error("Error loading revenue chart:", err);
            }

            try {
                const bestSellerNames = JSON.parse('@Html.Raw(ViewBag.BestSellerNamesJson)');
                const bestSellerQtys = JSON.parse('@Html.Raw(ViewBag.BestSellerQtysJson)');

                const donutOptions = {
                    series: bestSellerQtys,
                    labels: bestSellerNames,
                    chart: {
                        type: 'donut',
                        height: 330,
                        background: 'transparent',
                        foreColor: '#8A8A8A'
                    },
                    theme: { mode: 'dark' },
                    colors: ['#F5A623', '#E8651A', '#FFD54F', '#00E676', '#40C4FF'],
                    stroke: { show: false },
                    plotOptions: {
                        pie: {
                            donut: {
                                size: '70%',
                                background: 'transparent',
                                labels: {
                                    show: true,
                                    name: {
                                        show: true,
                                        fontSize: '14px',
                                        fontWeight: 600,
                                        color: '#8A8A8A',
                                        offsetY: -10
                                    },
                                    value: {
                                        show: true,
                                        fontSize: '20px',
                                        fontWeight: 800,
                                        color: '#F0EAE0',
                                        offsetY: 10,
                                        formatter: function (val) {
                                            return val + ' món';
                                        }
                                    },
                                    total: {
                                        show: true,
                                        label: 'Tổng bán',
                                        color: '#8A8A8A',
                                        formatter: function (w) {
                                            return w.globals.seriesTotals.reduce((a, b) => a + b, 0) + ' món';
                                        }
                                    }
                                }
                            }
                        }
                    },
                    legend: {
                        show: true,
                        position: 'bottom',
                        fontSize: '11px',
                        markers: { radius: 12 },
                        itemMargin: { horizontal: 6, vertical: 3 }
                    },
                    tooltip: {
                        theme: 'dark',
                        y: {
                            formatter: function (val) {
                                return val + ' cốc/phần';
                            }
                        }
                    }
                };

                const donutChart = new ApexCharts(document.querySelector("#bestSellersDonutChart"), donutOptions);
                donutChart.render();
            } catch (err) {
                console.error("Error loading donut chart:", err);
            }

            // Animated Counter
            const counters = document.querySelectorAll('.animated-counter');
            const speed = 200; // The lower the slower
            
            counters.forEach(counter => {
                const target = +counter.getAttribute('data-target');
                const isCurrency = counter.getAttribute('data-is-currency') !== "false";
                
                const updateCount = () => {
                    // Extract current value removing formatting
                    const text = counter.innerText.replace(/,/g, '').replace(/\./g, '').replace(' đ', '');
                    const count = +text || 0;
                    
                    // Lower inc to slow and higher to speed up
                    const inc = target / speed;
                    
                    if (count < target) {
                        const nextValue = Math.ceil(count + inc);
                        if (isCurrency) {
                            counter.innerText = nextValue.toLocaleString('vi-VN') + ' đ';
                        } else {
                            counter.innerText = nextValue;
                        }
                        // Call function every ms
                        setTimeout(updateCount, 15);
                    } else {
                        if (isCurrency) {
                            counter.innerText = target.toLocaleString('vi-VN') + ' đ';
                        } else {
                            counter.innerText = target;
                        }
                    }
                };
                
                // Only start if target > 0 to prevent NaN bugs
                if(target > 0) {
                    updateCount();
                } else {
                    if (isCurrency) counter.innerText = '0 đ';
                    else counter.innerText = '0';
                }
            });

            // Magnetic Buttons
            const magneticBtns = document.querySelectorAll('.magnetic-btn');
            magneticBtns.forEach(btn => {
                btn.addEventListener('mousemove', e => {
                    const rect = btn.getBoundingClientRect();
                    const h = rect.width / 2;
                    const x = e.clientX - rect.left - h;
                    const y = e.clientY - rect.top - rect.height / 2;
                    btn.style.transform = `translate(${x * 0.2}px, ${y * 0.2}px)`;
                });
                btn.addEventListener('mouseleave', () => {
                    btn.style.transform = `translate(0px, 0px)`;
                });
            });
        });
    </script>
}

@section Styles {
    <style>
        .dashboard-stat-card {
            border-radius: var(--radius-lg);
            position: relative;
        }

        .bg-emerald {
            background: var(--bg-emerald) !important;
        }
        
        .bg-latte {
            background: var(--bg-latte) !important;
        }
        
        .bg-sunset {
            background: var(--bg-sunset) !important;
        }

        .stat-icon-wrapper {
            font-size: 3.5rem;
            opacity: 0.15;
            transform: rotate(8deg) translateY(5px);
            transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            color: var(--cafe-text);
        }
        
        .dashboard-stat-card:hover .stat-icon-wrapper {
            opacity: 0.4;
            transform: rotate(0deg) scale(1.1);
        }
        
        .bg-emerald:hover .stat-icon-wrapper { color: var(--success-color); }
        .bg-latte:hover .stat-icon-wrapper { color: var(--cafe-primary); }
        .bg-sunset:hover .stat-icon-wrapper { color: var(--danger-color); }
    </style>
}