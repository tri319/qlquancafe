@model IEnumerable<QLquancafe.Models.Category>

@{
    ViewData["Title"] = "Quản lý loại món";
}

<div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-3 mb-5 stagger-item" style="--i: 1;">
    <div>
        <span class="text-uppercase tracking-wider text-muted fw-bold" style="font-size: 0.75rem; letter-spacing: 1.5px;">Quản Trị Hệ Thống</span>
        <h2 class="fw-extrabold mb-0 typewriter-text" style="color: var(--cafe-primary); font-weight: 800;">
            <i class="bi bi-tags-fill me-2" style="color: var(--cafe-secondary);"></i> QUẢN LÝ LOẠI MÓN
        </h2>
    </div>
    
    <a asp-action="Create" class="btn btn-cafe btn-pill shadow magnetic-btn">
        <i class="bi bi-plus-circle-fill"></i> Thêm loại món mới
    </a>
</div>

<!-- Modern Glass Data Table -->
<div class="table-modern-wrapper stagger-item" style="--i: 2; max-width: 800px; margin: 0 auto;">
    <table class="table table-hover align-middle">
        <thead>
            <tr>
                <th class="ps-4">Tên loại món</th>
                <th class="text-center pe-4" style="width: 250px;">Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="2" class="text-center text-muted py-5">
                        <div class="py-4">
                            <i class="bi bi-inbox text-light display-3 opacity-25"></i>
                            <p class="mt-2 mb-0 fw-bold fs-5 text-muted">Danh sách loại món trống.</p>
                        </div>
                    </td>
                </tr>
            }
            @{ int index = 3; }
            @foreach (var item in Model)
            {
                <tr class="stagger-item" style="--i: @index;">
                    <td class="ps-4">
                        <strong class="fs-6" style="color: var(--cafe-text);"><i class="bi bi-bookmark-fill me-2" style="color: var(--cafe-secondary); font-size: 0.85rem;"></i> @item.Name</strong>
                    </td>
                    <td class="text-center pe-4">
                        <div class="d-inline-flex gap-2">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning btn-pill" style="font-size: 0.85rem;">
                                <i class="bi bi-pencil-square"></i> Sửa
                            </a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger btn-pill" style="font-size: 0.85rem;">
                                <i class="bi bi-trash"></i> Xóa
                            </a>
                        </div>
                    </td>
                </tr>
                index++;
            }
        </tbody>
    </table>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Magnetic Buttons
            const magneticBtns = document.querySelectorAll('.magnetic-btn');
            magneticBtns.forEach(btn => {
                btn.addEventListener('mousemove', e => {
                    const rect = btn.getBoundingClientRect();
                    const h = rect.width / 2;
                    const x = e.clientX - rect.left - h;
                    const y = e.clientY - rect.top - rect.height / 2;
                    btn.style.transform = `translate(${x * 0.2}px, ${y * 0.2}px)`;
                });
                btn.addEventListener('mouseleave', () => {
                    btn.style.transform = `translate(0px, 0px)`;
                });
            });
        });
    </script>
}