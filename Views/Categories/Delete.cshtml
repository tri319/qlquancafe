@model QLquancafe.Models.Category

@{
    ViewData["Title"] = "Xóa loại món";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow mt-4">
            <div class="card-header bg-danger text-white">
                <h4 class="mb-0">Xóa loại món</h4>
            </div>
            <div class="card-body">
                <h5 class="text-danger mb-4">Bạn có chắc chắn muốn xóa loại món này?</h5>
                
                <dl class="row">
                    <dt class="col-sm-4">Tên loại món:</dt>
                    <dd class="col-sm-8 fw-bold">@Model.Name</dd>
                </dl>

                <form asp-action="Delete" class="mt-4 border-top pt-3">
                    <input type="hidden" asp-for="Id" />
                    <div class="d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-secondary">Trở về</a>
                        <button type="submit" class="btn btn-danger">Xóa</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
