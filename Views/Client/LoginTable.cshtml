@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Đăng Nhập Bàn - Quản Lý Quán Cafe</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" />
    
    <style>
        body {
            /* Using CSS custom properties from site.css */
            background-color: var(--cafe-bg);
            color: var(--cafe-text);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0;
            padding: 16px;
            overflow: hidden; /* Hide scrollbars for the particle effect */
        }

        .minimal-login-card {
            background: var(--cafe-surface);
            border: 1px solid rgba(245, 166, 35, 0.1);
            border-radius: var(--radius-lg);
            box-shadow: var(--shadow-hover);
            width: 100%;
            max-width: 900px;
            display: flex;
            overflow: hidden;
            min-height: 550px;
            z-index: 10;
        }

        /* Left Side: Advertising Image with Dark Gradient */
        .promo-image-side {
            width: 50%;
            background: linear-gradient(rgba(13, 13, 13, 0.4), rgba(13, 13, 13, 0.9)), 
                        url('https://images.unsplash.com/photo-1507133750040-4a8f57021571?auto=format&fit=crop&w=800&q=80') no-repeat center center;
            background-size: cover;
            display: flex;
            flex-direction: column;
            justify-content: flex-end;
            padding: 3.5rem 2.5rem;
            color: var(--cafe-text);
            position: relative;
        }

        .promo-title {
            font-weight: 800;
            font-size: 1.8rem;
            margin-bottom: 0.6rem;
            color: var(--cafe-primary);
            letter-spacing: 0.5px;
            text-shadow: 0 0 15px rgba(245, 166, 35, 0.3);
        }

        .promo-desc {
            font-size: 0.95rem;
            opacity: 0.9;
            line-height: 1.5;
            color: var(--cafe-text-muted);
        }

        /* Right Side: Simple & Elegant Login Form */
        .form-side {
            width: 50%;
            padding: 4rem 3rem;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            text-align: center;
            background: var(--cafe-bg-secondary);
        }

        .brand-icon {
            display: inline-flex;
            width: 70px;
            height: 70px;
            background: linear-gradient(135deg, var(--cafe-surface) 0%, var(--cafe-surface-hover) 100%);
            color: var(--cafe-primary);
            border: 1px solid rgba(245, 166, 35, 0.2);
            border-radius: 50%;
            align-items: center;
            justify-content: center;
            font-size: 2rem;
            margin-bottom: 1.5rem;
            box-shadow: var(--shadow-neon);
        }

        .input-code {
            border: 2px solid rgba(245, 166, 35, 0.15) !important;
            font-size: 1.5rem !important;
            font-weight: 700;
            border-radius: var(--radius-sm) !important;
            letter-spacing: 4px;
            text-transform: uppercase;
            padding: 1rem !important;
            background-color: var(--cafe-surface) !important;
            color: var(--cafe-text) !important;
            transition: all 0.3s ease !important;
            text-align: center;
        }

        .input-code:focus {
            border-color: var(--cafe-primary) !important;
            box-shadow: var(--shadow-neon) !important;
            background-color: var(--cafe-surface-hover) !important;
        }

        .input-code::placeholder {
            letter-spacing: normal;
            font-size: 1rem;
            font-weight: 400;
            text-transform: none;
            color: var(--cafe-text-muted);
        }

        .btn-enter {
            background: linear-gradient(135deg, var(--cafe-primary) 0%, var(--cafe-secondary) 100%);
            border: none;
            color: #0D0D0D;
            font-weight: 800;
            font-size: 1.1rem;
            border-radius: var(--radius-sm);
            padding: 1rem;
            transition: all 0.3s ease;
            box-shadow: 0 0 15px rgba(245, 166, 35, 0.2);
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .btn-enter:hover {
            transform: translateY(-2px);
            box-shadow: var(--shadow-neon-strong);
            background: linear-gradient(135deg, var(--cafe-accent) 0%, var(--cafe-primary) 100%);
        }

        /* Responsive Layout */
        @@media (max-width: 768px) {
            .minimal-login-card {
                max-width: 440px;
                flex-direction: column;
                min-height: auto;
            }
            .promo-image-side {
                display: none;
            }
            .form-side {
                width: 100%;
                padding: 3.5rem 2rem;
            }
        }
        
        /* Custom cursor trail container */
        #cursor-trail-container {
            position: fixed;
            top: 0; left: 0;
            width: 100vw; height: 100vh;
            pointer-events: none;
            z-index: 9999;
        }
        .trail-dot {
            position: absolute;
            background: var(--cafe-primary);
            border-radius: 50%;
            pointer-events: none;
            transform: translate(-50%, -50%);
            opacity: 0.8;
            box-shadow: 0 0 10px var(--cafe-primary);
        }
    </style>
</head>
<body>
    
    <!-- Cursor Trail Container -->
    <div id="cursor-trail-container"></div>

    <div class="minimal-login-card gradient-border-card">
        
        <!-- Left Side: Advertising Image and Promotions -->
        <div class="promo-image-side text-start stagger-item" style="--i: 1; z-index: 2;">
            <span class="badge text-dark text-uppercase fw-bold mb-3 align-self-start" style="font-size: 0.75rem; letter-spacing: 0.5px; background-color: var(--cafe-accent);">Trải nghiệm đẳng cấp</span>
            <h4 class="promo-title typewriter-text">THƯỞNG THỨC<br/>HƯƠNG VỊ ĐẬM ĐÀ</h4>
            <p class="promo-desc mb-0 mt-3">Không gian sang trọng, hạt cà phê Arabica thượng hạng được rang xay nguyên chất mang đến vị đắng êm dịu.</p>
        </div>

        <!-- Right Side: Clean Centered Login Form -->
        <div class="form-side stagger-item" style="--i: 2; z-index: 2;">
            <div class="brand-icon">
                <i class="bi bi-cup-hot-fill animate-steam"></i>
            </div>

            <h3 class="fw-extrabold mb-2" style="color: var(--cafe-text); letter-spacing: 0.5px;">QL CAFE</h3>
            <p class="text-muted mb-4 small px-2" style="font-size: 0.85rem; line-height: 1.45;">Nhập mã số ghi trên bàn của bạn để truy cập thực đơn điện tử và bắt đầu gọi món trực tiếp.</p>

            <form asp-action="AccessByTable" method="post" autocomplete="off" class="w-100 px-1">
                <div class="text-danger mb-3 text-start small fw-bold" asp-validation-summary="ModelOnly"></div>

                <div class="form-group mb-4">
                    <input type="text" name="tableCode" class="form-control input-code" 
                           placeholder="Ví dụ: BAN01" required />
                </div>

                <button type="submit" class="btn btn-enter w-100 d-flex align-items-center justify-content-center gap-2 magnetic-btn">
                    VÀO THỰC ĐƠN <i class="bi bi-arrow-right fs-5"></i>
                </button>
            </form>
        </div>
        
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    
    <script>
        $(document).ready(function() {
            // Magnetic Button
            const magneticBtns = document.querySelectorAll('.magnetic-btn');
            magneticBtns.forEach(btn => {
                btn.addEventListener('mousemove', e => {
                    const rect = btn.getBoundingClientRect();
                    const h = rect.width / 2;
                    const x = e.clientX - rect.left - h;
                    const y = e.clientY - rect.top - rect.height / 2;
                    btn.style.transform = `translate(${x * 0.2}px, ${y * 0.2}px)`;
                });
                
                btn.addEventListener('mouseleave', () => {
                    btn.style.transform = `translate(0px, 0px)`;
                });
            });

            // Ripple effect
            $(document).on('click', '.btn', function(e) {
                var $btn = $(this);
                if($btn.css('position') === 'static') $btn.css('position', 'relative');
                var ripple = $('<span class="ripple"></span>');
                var size = Math.max($btn.outerWidth(), $btn.outerHeight());
                ripple.css({
                    width: size, height: size,
                    left: e.pageX - $btn.offset().left - size / 2,
                    top: e.pageY - $btn.offset().top - size / 2
                });
                $btn.append(ripple);
                setTimeout(function() { ripple.remove(); }, 600);
            });

            // Custom Cursor Glow Trail
            const trailContainer = document.getElementById('cursor-trail-container');
            const dots = [];
            const numDots = 12;

            for (let i = 0; i < numDots; i++) {
                let dot = document.createElement('div');
                dot.className = 'trail-dot';
                // Decreasing size and opacity
                let size = 12 - i;
                dot.style.width = size + 'px';
                dot.style.height = size + 'px';
                dot.style.opacity = 1 - (i / numDots);
                trailContainer.appendChild(dot);
                dots.push({ x: 0, y: 0, node: dot });
            }

            let mouseX = 0, mouseY = 0;

            document.addEventListener('mousemove', function(e) {
                mouseX = e.clientX;
                mouseY = e.clientY;
            });

            function renderTrail() {
                let x = mouseX;
                let y = mouseY;

                dots.forEach(function(dot, index) {
                    let nextDot = dots[index + 1] || dots[0];
                    
                    dot.x = x;
                    dot.y = y;
                    
                    dot.node.style.left = x + 'px';
                    dot.node.style.top = y + 'px';
                    
                    // LERP for the trail effect
                    x += (nextDot.x - x) * 0.5;
                    y += (nextDot.y - y) * 0.5;
                });
                requestAnimationFrame(renderTrail);
            }
            renderTrail();
        });
    </script>
</body>
</html>