@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Đăng Nhập Bàn - Quản Lý Quán Cafe</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;700&display=swap" rel="stylesheet">
    
    <style>
        :root {
            --cafe-primary: #3E2723;
            --cafe-secondary: #8D6E63;
            --cafe-light: #F5F2EB;
            --cafe-bg: #FAF8F5;
            --radius-md: 20px;
        }

        body {
            font-family: 'Outfit', sans-serif;
            background-color: var(--cafe-bg);
            color: var(--cafe-primary);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0;
            padding: 15px;
        }

        .minimal-login-card {
            background-color: #FFFFFF;
            border: 1px solid rgba(141, 110, 99, 0.12);
            border-radius: var(--radius-md);
            box-shadow: 0 15px 40px rgba(62, 39, 35, 0.06);
            width: 100%;
            max-width: 820px;
            display: flex;
            overflow: hidden;
            min-height: 480px;
            transition: all 0.3s ease;
        }

        /* Left Side: Advertising Image */
        .promo-image-side {
            width: 50%;
            background: linear-gradient(rgba(62, 39, 35, 0.65), rgba(62, 39, 35, 0.65)), 
                        url('https://images.unsplash.com/photo-1507133750040-4a8f57021571?auto=format&fit=crop&w=800&q=80') no-repeat center center;
            background-size: cover;
            display: flex;
            flex-direction: column;
            justify-content: flex-end;
            padding: 3rem 2rem;
            color: #FFFFFF;
        }

        .promo-title {
            font-weight: 700;
            font-size: 1.6rem;
            margin-bottom: 0.5rem;
            color: #FFD54F;
        }

        .promo-desc {
            font-size: 0.9rem;
            opacity: 0.85;
            line-height: 1.4;
        }

        /* Right Side: Simple Login Form */
        .form-side {
            width: 50%;
            padding: 3.5rem 3rem;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            text-align: center;
        }

        .brand-icon {
            display: inline-flex;
            width: 60px;
            height: 60px;
            background-color: var(--cafe-light);
            color: var(--cafe-secondary);
            border-radius: 50%;
            align-items: center;
            justify-content: center;
            font-size: 1.6rem;
            margin-bottom: 1.25rem;
        }

        .input-code {
            border: 1.5px solid rgba(141, 110, 99, 0.2) !important;
            font-size: 1.3rem !important;
            font-weight: 700;
            border-radius: 10px !important;
            letter-spacing: 3px;
            text-transform: uppercase;
            padding: 0.8rem 1rem !important;
            background-color: #FCFBF9 !important;
            color: var(--cafe-primary) !important;
            transition: all 0.25s ease !important;
            text-align: center;
        }

        .input-code:focus {
            border-color: var(--cafe-secondary) !important;
            box-shadow: 0 0 0 4px rgba(141, 110, 99, 0.1) !important;
            background-color: #FFFFFF !important;
        }

        .input-code::placeholder {
            letter-spacing: normal;
            font-size: 0.95rem;
            font-weight: 400;
            text-transform: none;
            color: #A09085;
        }

        .btn-enter {
            background-color: var(--cafe-primary);
            border: none;
            color: #FFFFFF;
            font-weight: 600;
            font-size: 1.05rem;
            border-radius: 10px;
            padding: 0.85rem;
            transition: all 0.25s ease;
        }

        .btn-enter:hover {
            background-color: #271410;
            color: #FFFFFF;
            transform: translateY(-1px);
        }

        .btn-enter:active {
            transform: scale(0.98);
        }
        /* Responsive Layout styles */
        @@media (max-width: 768px) {
            .minimal-login-card {
                max-width: 420px;
                flex-direction: column;
                min-height: auto;
            }

            .promo-image-side {
                display: none; /* Hide advertising image on smaller screens to keep it simple */
            }

            .form-side {
                width: 100%;
                padding: 3rem 2rem;
            }
        }
    </style>
</head>
<body>
    <div class="minimal-login-card">
        
        <!-- Left Side: Advertising Image and Promotions -->
        <div class="promo-image-side text-start">
            <span class="badge bg-warning text-dark text-uppercase fw-bold mb-2 align-self-start" style="font-size: 0.75rem; letter-spacing: 0.5px;">Quảng Cáo Đặc Biệt</span>
            <h4 class="promo-title">THƯỞNG THỨC HƯƠNG VỊ ĐẬM ĐÀ</h4>
            <p class="promo-desc mb-0">Hạt cà phê Arabica thượng hạng được rang xay nguyên chất mang đến vị đắng êm dịu, sảng khoái suốt ngày dài.</p>
        </div>

        <!-- Right Side: Clean Centered Login Form -->
        <div class="form-side">
            <div class="brand-icon">
                <i class="bi bi-cup-hot-fill"></i>
            </div>

            <h3 class="fw-bold mb-1" style="color: var(--cafe-primary);">QL CAFE</h3>
            <p class="text-muted mb-4 small" style="font-size: 0.85rem;">Nhập mã số ghi trên bàn để bắt đầu gọi món trực tiếp</p>

            <form asp-action="AccessByTable" method="post" autocomplete="off" class="w-100">
                <div class="text-danger mb-3 text-start small fw-bold" asp-validation-summary="ModelOnly"></div>

                <div class="form-group mb-4">
                    <input type="text" name="tableCode" class="form-control input-code" 
                           placeholder="Ví dụ: BAN01" required />
                </div>

                <button type="submit" class="btn btn-enter w-100 d-flex align-items-center justify-content-center gap-2">
                    Bắt đầu gọi món <i class="bi bi-arrow-right"></i>
                </button>
            </form>
        </div>
        
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>