@model IEnumerable<QLquancafe.Models.ViewModels.AdminUserViewModel>

@{
    ViewData["Title"] = "Quản lý nhân viên";
}

<div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-3 mb-5 animate-fade-up">
    <div>
        <span class="text-uppercase tracking-wider text-muted fw-bold" style="font-size: 0.75rem; letter-spacing: 1.5px;">Quản Trị Hệ Thống</span>
        <h2 class="fw-extrabold mb-0" style="color: var(--cafe-primary); font-weight: 800;">
            <i class="bi bi-people-fill me-2" style="color: var(--cafe-secondary);"></i> QUẢN LÝ NHÂN VIÊN
        </h2>
    </div>
    
    <a asp-action="Create" class="btn btn-cafe btn-pill shadow">
        <i class="bi bi-person-plus-fill"></i> Tạo tài khoản Staff mới
    </a>
</div>

<!-- Modern Glass Data Table -->
<div class="table-modern-wrapper animate-fade-up" style="animation-delay: 0.1s; max-width: 900px; margin: 0 auto;">
    <table class="table table-hover align-middle">
        <thead>
            <tr>
                <th class="ps-4">Tài khoản Email</th>
                <th class="text-center">Quyền hạn</th>
                <th class="text-center pe-4" style="width: 180px;">Hành động</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var item in Model)
                {
                    <tr>
                        <td class="ps-4">
                            <div class="d-flex align-items-center gap-2">
                                <div class="rounded-circle bg-light d-flex align-items-center justify-content-center border" style="width: 40px; height: 40px; border-color: rgba(62, 39, 35, 0.15) !important;">
                                    <i class="bi bi-envelope-at text-muted fs-5"></i>
                                </div>
                                <strong class="text-dark fs-6">@item.Email</strong>
                            </div>
                        </td>
                        <td class="text-center">
                            @if (item.Role == "Admin")
                            {
                                <span class="badge bg-danger-subtle text-danger rounded-pill px-3">
                                    <i class="bi bi-shield-fill-check me-1"></i> @item.Role
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-warning-subtle text-warning rounded-pill px-3">
                                    <i class="bi bi-person-badge-fill me-1"></i> @item.Role
                                </span>
                            }
                        </td>
                        <td class="text-center pe-4">
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-light btn-pill border" style="font-size: 0.85rem;">
                                <i class="bi bi-trash-fill text-danger"></i> Xóa tài khoản
                            </a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="3" class="text-center text-muted py-5">
                        <div class="py-4">
                            <i class="bi bi-inbox text-light display-3"></i>
                            <p class="mt-2 mb-0 fw-bold fs-5">Không có tài khoản nhân viên nào được liệt kê.</p>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
