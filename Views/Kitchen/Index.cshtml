@model IEnumerable<QLquancafe.Models.Order>
@{
    ViewData["Title"] = "Màn hình Quầy Bếp / Quầy Bar - Kanban";
}

<div class="d-flex justify-content-between align-items-center my-4 flex-wrap gap-3 stagger-item" style="--i: 1;">
    <div>
        <h1 class="display-6 fw-extrabold mb-0" style="font-weight: 800; letter-spacing: 0.5px; color: var(--cafe-primary);">
            <i class="bi bi-cup-hot-fill text-warning me-2 animate-pulse"></i>DASHBOARD QUẦY BẾP / QUẦY BAR ☕
        </h1>
        <p class="text-muted mb-0 small">Bảng điều phối pha chế và gọi phục vụ thời gian thực thời thượng</p>
    </div>
    <div class="d-flex align-items-center gap-3">
        <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-2 font-monospace fw-bold" id="signalrStatus">
            <span class="spinner-grow spinner-grow-sm text-success me-1" role="status" aria-hidden="true"></span> Real-time Connected
        </span>
    </div>
</div>

<!-- Kanban Board Grid -->
<div class="row g-4 pb-5 stagger-item" style="--i: 2;">
    <!-- Column 1: Chờ pha chế -->
    <div class="col-lg-4">
        <div class="kanban-col-wrapper glass-panel">
            <div class="kanban-col-header bg-pending-glow d-flex justify-content-between align-items-center">
                <span class="fw-extrabold text-uppercase text-white" style="letter-spacing:1px;"><i class="bi bi-hourglass-split me-2"></i>Chờ Pha Chế</span>
                <span class="badge rounded-pill bg-light text-dark font-monospace fw-bold" id="countPending">0</span>
            </div>
            <div class="kanban-cards-container column-dropzone" id="colPending" data-status="Pending" ondragover="allowDrop(event)" ondrop="handleDrop(event)">
                @foreach (var order in Model.Where(o => o.Status == "Pending"))
                {
                    @await Html.PartialAsync("_KitchenOrderCard", order)
                }
            </div>
        </div>
    </div>

    <!-- Column 2: Đang thực hiện -->
    <div class="col-lg-4">
        <div class="kanban-col-wrapper glass-panel">
            <div class="kanban-col-header bg-preparing-glow d-flex justify-content-between align-items-center">
                <span class="fw-extrabold text-uppercase text-white" style="letter-spacing:1px;"><i class="bi bi-fire me-2 text-warning animate-steam"></i>Đang Pha Chế</span>
                <span class="badge rounded-pill bg-warning text-dark font-monospace fw-bold" id="countPreparing">0</span>
            </div>
            <div class="kanban-cards-container column-dropzone" id="colPreparing" data-status="Preparing" ondragover="allowDrop(event)" ondrop="handleDrop(event)">
                @foreach (var order in Model.Where(o => o.Status == "Preparing"))
                {
                    @await Html.PartialAsync("_KitchenOrderCard", order)
                }
            </div>
        </div>
    </div>

    <!-- Column 3: Đã xong / Chờ phục vụ -->
    <div class="col-lg-4">
        <div class="kanban-col-wrapper glass-panel">
            <div class="kanban-col-header bg-ready-glow d-flex justify-content-between align-items-center">
                <span class="fw-extrabold text-uppercase text-white" style="letter-spacing:1px;"><i class="bi bi-check2-circle me-2 text-success"></i>Đã Xong / Chờ Phục Vụ</span>
                <span class="badge rounded-pill bg-success text-white font-monospace fw-bold" id="countReady">0</span>
            </div>
            <div class="kanban-cards-container column-dropzone" id="colReady" data-status="Ready" ondragover="allowDrop(event)" ondrop="handleDrop(event)">
                @foreach (var order in Model.Where(o => o.Status == "Ready"))
                {
                    @await Html.PartialAsync("_KitchenOrderCard", order)
                }
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        body {
            background-color: var(--cafe-bg) !important;
        }

        /* Glassmorphism Kanban Columns */
        .kanban-col-wrapper {
            background: var(--glass-bg);
            border: 1px solid var(--glass-border);
            border-radius: var(--radius-lg);
            overflow: hidden;
            display: flex;
            flex-direction: column;
            min-height: 70vh;
            box-shadow: var(--glass-shadow);
        }

        .kanban-col-header {
            padding: 18px 20px;
            font-weight: 800;
            font-size: 0.92rem;
            border-bottom: 1px solid var(--glass-border);
        }

        .bg-pending-glow {
            background: linear-gradient(135deg, rgba(80, 80, 80, 0.06) 0%, rgba(80, 80, 80, 0.01) 100%);
            border-bottom: 2px solid rgba(0, 0, 0, 0.1) !important;
        }
        .bg-pending-glow .text-white {
            color: var(--cafe-text) !important;
        }

        .bg-preparing-glow {
            background: linear-gradient(135deg, rgba(232, 101, 26, 0.08) 0%, rgba(232, 101, 26, 0.01) 100%);
            border-bottom: 2px solid var(--cafe-secondary) !important;
        }
        .bg-preparing-glow .text-white {
            color: var(--cafe-secondary) !important;
        }

        .bg-ready-glow {
            background: linear-gradient(135deg, rgba(16, 185, 129, 0.08) 0%, rgba(16, 185, 129, 0.01) 100%);
            border-bottom: 2px solid var(--success-color) !important;
        }
        .bg-ready-glow .text-white {
            color: var(--success-color) !important;
        }

        /* Dark Theme Override for Kanban Columns */
        [data-theme="dark"] .kanban-col-wrapper {
            background: rgba(22, 22, 22, 0.7);
            border: 1px solid rgba(255, 255, 255, 0.05);
            box-shadow: 0 15px 35px rgba(0,0,0,0.4);
        }

        [data-theme="dark"] .kanban-col-header {
            border-bottom: 1px solid rgba(255,255,255,0.05);
        }

        [data-theme="dark"] .bg-pending-glow {
            background: linear-gradient(135deg, rgba(80, 80, 80, 0.4) 0%, rgba(30, 30, 30, 0.4) 100%);
            border-bottom: 2px solid rgba(255,255,255,0.15) !important;
        }
        [data-theme="dark"] .bg-pending-glow .text-white {
            color: #ffffff !important;
        }

        [data-theme="dark"] .bg-preparing-glow {
            background: linear-gradient(135deg, rgba(232, 101, 26, 0.25) 0%, rgba(30, 30, 30, 0.4) 100%);
            border-bottom: 2px solid var(--cafe-secondary) !important;
        }
        [data-theme="dark"] .bg-preparing-glow .text-white {
            color: #ffffff !important;
        }

        [data-theme="dark"] .bg-ready-glow {
            background: linear-gradient(135deg, rgba(0, 230, 118, 0.2) 0%, rgba(30, 30, 30, 0.4) 100%);
            border-bottom: 2px solid var(--success-color) !important;
        }
        [data-theme="dark"] .bg-ready-glow .text-white {
            color: #ffffff !important;
        }

        .kanban-cards-container {
            padding: 16px;
            flex-grow: 1;
            overflow-y: auto;
            display: flex;
            flex-direction: column;
            gap: 16px;
            min-height: 60vh;
            transition: background-color 0.25s ease;
        }

        /* Drag Over highlighting */
        .column-dropzone.dragover {
            background-color: rgba(245, 166, 35, 0.04);
            outline: 2px dashed rgba(245, 166, 35, 0.25);
            outline-offset: -8px;
        }

        /* Responsive Columns on Tablet */
        @@media (max-width: 991px) {
            .kanban-col-wrapper {
                min-height: 400px;
                margin-bottom: 20px;
            }
        }
    </style>
}

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/6.0.1/signalr.min.js"></script>
    <script>
        // Audio synthesis for Kitchen chime alerts
        function playChimeAlert() {
            try {
                var AudioContext = window.AudioContext || window.webkitAudioContext;
                if (!AudioContext) return;
                var ctx = new AudioContext();
                
                var osc = ctx.createOscillator();
                var gain = ctx.createGain();
                osc.type = 'sine';
                osc.frequency.setValueAtTime(1046.50, ctx.currentTime); // C6
                osc.connect(gain);
                gain.connect(ctx.destination);
                gain.gain.setValueAtTime(0.25, ctx.currentTime);
                gain.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + 0.8);
                osc.start();
                osc.stop(ctx.currentTime + 0.8);
                
                setTimeout(function() {
                    try {
                        var osc2 = ctx.createOscillator();
                        var gain2 = ctx.createGain();
                        osc2.type = 'sine';
                        osc2.frequency.setValueAtTime(1318.51, ctx.currentTime); // E6
                        osc2.connect(gain2);
                        gain2.connect(ctx.destination);
                        gain2.gain.setValueAtTime(0.2, ctx.currentTime);
                        gain2.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + 1.0);
                        osc2.start();
                        osc2.stop(ctx.currentTime + 1.0);
                    } catch(e) {}
                }, 150);
            } catch(e) {
                console.warn(e);
            }
        }

        $(document).ready(function() {
            // Cập nhật đếm số lượng card các cột
            updateCardCounts();

            // Kích hoạt đồng hồ đếm ngược thời gian thực
            setInterval(updateCountdownTimers, 1000);
            updateCountdownTimers();

            // Khởi tạo kết nối SignalR thời gian thực
            var kitchenConnection = new signalR.HubConnectionBuilder()
                .withUrl("/notificationHub")
                .withAutomaticReconnect()
                .build();

            kitchenConnection.start().then(function () {
                console.log("Kitchen Kanban SignalR Connected!");
                $("#signalrStatus").html('<span class="spinner-grow spinner-grow-sm text-success me-1"></span> Real-time Connected').removeClass("bg-danger-subtle text-danger").addClass("bg-success-subtle text-success");
            }).catch(function (err) {
                console.error("Kitchen SignalR connection fail: ", err.toString());
                $("#signalrStatus").html('<i class="bi bi-exclamation-triangle-fill me-1"></i> Disconnected').removeClass("bg-success-subtle text-success").addClass("bg-danger-subtle text-danger");
            });

            // 1. Nhận sự kiện có ĐƠN HÀNG MỚI từ E-Menu bàn
            kitchenConnection.on("ReceiveNewOrder", function(orderId, tableName) {
                playChimeAlert();
                showToast("🔔 BÀN MỚI ORDER: " + tableName + " vừa gửi yêu cầu pha chế!", "warning");
                
                // AJAX tải card đơn hàng riêng lẻ và trượt vào cột Pending
                $.get("/Kitchen/Index", function(html) {
                    var $temp = $("<div>").html(html);
                    var $newCard = $temp.find('#card_' + orderId);
                    
                    // Nếu card chưa có trên màn hình bếp -> Thêm vào cột Pending
                    if ($newCard.length && $('#card_' + orderId).length === 0) {
                        $newCard.css('opacity', '0').css('transform', 'scale(0.85)');
                        $('#colPending').prepend($newCard);
                        
                        // Kích hoạt hiệu ứng pop-in thời thượng
                        $newCard.animate({ opacity: 1 }, 300);
                        $newCard[0].style.transform = "scale(1)";
                        
                        updateCardCounts();
                        updateCountdownTimers();
                    }
                });
            });

            // 2. Nhận sự kiện đồng bộ trạng thái đơn hàng khi quầy khác di chuyển
            kitchenConnection.on("ReceiveOrderStatusUpdate", function(orderId, status) {
                var $card = $('#card_' + orderId);
                if ($card.length) {
                    var $destCol = $('#col' + status);
                    if ($destCol.length && $card.parent().attr('id') !== $destCol.attr('id')) {
                        // Di chuyển card sang cột tương ứng
                        $card.fadeOut(250, function() {
                            $destCol.append($card);
                            
                            // Cập nhật các nút trạng thái bên trong card để phù hợp với cột mới
                            updateCardActionButtons($card, status);
                            
                            $card.fadeIn(250);
                            updateCardCounts();
                        });
                    }
                }
            });
        });

        // Đếm và cập nhật số lượng badge của mỗi cột Kanban
        function updateCardCounts() {
            $('#countPending').text($('#colPending').children('.kitchen-order-card').length);
            $('#countPreparing').text($('#colPreparing').children('.kitchen-order-card').length);
            $('#countReady').text($('#colReady').children('.kitchen-order-card').length);
        }

        // Cập nhật đồng hồ đếm ngược và đổi màu viền card động
        function updateCountdownTimers() {
            $('.kitchen-order-card').each(function() {
                var orderDateStr = $(this).data('order-date');
                if (!orderDateStr) return;

                var orderDate = new Date(orderDateStr);
                var diffMs = new Date() - orderDate;
                var diffSec = Math.floor(diffMs / 1000);
                
                var min = Math.floor(diffSec / 60);
                var sec = diffSec % 60;
                
                var timeString = (min < 10 ? '0' : '') + min + ':' + (sec < 10 ? '0' : '') + sec;
                $(this).find('.timer-badge').text(timeString);

                // Quyết định màu sắc khung viền dựa trên thời gian đếm ngược
                var $glowBorder = $(this);
                
                $glowBorder.removeClass('border-green border-yellow border-red-pulsing');
                
                if (min < 5) {
                    $glowBorder.addClass('border-green');
                } else if (min < 10) {
                    $glowBorder.addClass('border-yellow');
                } else {
                    $glowBorder.addClass('border-red-pulsing');
                }
            });
        }

        // Đồng bộ hóa các nút bấm hành động bên trong card sau khi kéo/chuyển trạng thái
        function updateCardActionButtons($card, status) {
            var orderId = $card.data('order-id');
            var actionArea = $card.find('.card-action-area');
            actionArea.empty();

            if (status === "Pending") {
                actionArea.append('<button onclick="changeStatus(' + orderId + ', \'Preparing\')" class="btn btn-sm btn-pill btn-cafe-preparing w-100 py-2 font-semibold"><i class="bi bi-play-fill me-1"></i> Bắt đầu Pha Chế</button>');
            } else if (status === "Preparing") {
                actionArea.append('<button onclick="changeStatus(' + orderId + ', \'Ready\')" class="btn btn-sm btn-pill btn-cafe-ready w-100 py-2 font-semibold"><i class="bi bi-check2 me-1"></i> Hoàn Thành ➔</button>');
            } else if (status === "Ready") {
                actionArea.append('<button onclick="changeStatus(' + orderId + ', \'Completed\')" class="btn btn-sm btn-pill btn-cafe-complete w-100 py-2 font-semibold"><i class="bi bi-box-arrow-right me-1"></i> Đã Giao Khách</button>');
            }
        }

        // Thực hiện gửi AJAX cập nhật trạng thái đơn hàng
        function changeStatus(orderId, newStatus) {
            var $card = $('#card_' + orderId);
            
            // Nếu đổi sang Completed -> Remove card khỏi màn hình bếp
            if (newStatus === "Completed") {
                $card.fadeOut(300, function() {
                    $card.remove();
                    updateCardCounts();
                });
            }

            $.ajax({
                url: '/Kitchen/UpdateStatus',
                type: 'POST',
                data: { id: orderId, status: newStatus },
                success: function(res) {
                    if (res.success) {
                        if (newStatus !== "Completed") {
                            var $destCol = $('#col' + newStatus);
                            if ($destCol.length) {
                                $card.fadeOut(250, function() {
                                    $destCol.append($card);
                                    updateCardActionButtons($card, newStatus);
                                    $card.fadeIn(250);
                                    updateCardCounts();
                                    updateCountdownTimers();
                                    showToast("🎉 Đơn hàng #" + orderId + " đã chuyển sang " + newStatus, "success");
                                });
                            }
                        } else {
                            showToast("✔ Đã giao phục vụ đơn hàng #" + orderId + " thành công!", "success");
                        }
                    } else {
                        showToast("❌ " + res.message, "danger");
                        $card.fadeIn(1); // Hiện lại nếu lỗi
                        updateCardCounts();
                    }
                },
                error: function() {
                    showToast("❌ Không thể kết nối tới quầy bar!", "danger");
                    $card.fadeIn(1);
                    updateCardCounts();
                }
            });
        }

        // --- CƠ CHẾ KÉO THẢ KANBAN (DRAG & DROP) ---
        function allowDrop(ev) {
            ev.preventDefault();
            $(ev.currentTarget).addClass('dragover');
        }

        // Xóa highlight khi kéo đi ra ngoài vùng thả
        $('.column-dropzone').on('dragleave', function(e) {
            $(this).removeClass('dragover');
        });

        function handleDragStart(ev) {
            ev.dataTransfer.setData("text/plain", ev.currentTarget.id);
            // Thêm class mờ khi đang kéo
            setTimeout(() => {
                $(ev.target).css('opacity', '0.4');
            }, 0);
        }

        function handleDragEnd(ev) {
            $(ev.currentTarget).css('opacity', '1');
            $('.column-dropzone').removeClass('dragover');
        }

        function handleDrop(ev) {
            ev.preventDefault();
            $('.column-dropzone').removeClass('dragover');
            
            var cardId = ev.dataTransfer.getData("text/plain");
            var $card = $('#' + cardId);
            var $targetCol = $(ev.currentTarget).closest('.column-dropzone');
            
            if ($card.length && $targetCol.length) {
                var orderId = $card.data('order-id');
                var newStatus = $targetCol.data('status');
                var oldStatus = $card.parent().data('status');

                if (newStatus !== oldStatus) {
                    changeStatus(orderId, newStatus);
                }
            }
        }
    </script>
}
