@page
@model LoginModel

@{
    ViewData["Title"] = "Đăng nhập";
    Layout = "/Views/Shared/_Layout.cshtml";
}

<div class="row justify-content-center py-5">
    
    <!-- Cursor Trail Container (Now Global) -->

    <div class="col-md-6 col-lg-5 stagger-item" style="--i: 1;">
        <div class="card gradient-border-card shadow-hover">
            <div class="card-body p-4 p-md-5 position-relative" style="z-index: 2;">
                <div class="text-center mb-4">
                    <div class="d-inline-flex align-items-center justify-content-center rounded-circle mb-3" style="width: 70px; height: 70px; background: linear-gradient(135deg, var(--cafe-surface) 0%, var(--cafe-surface-hover) 100%); color: var(--cafe-primary); border: 1px solid rgba(245, 166, 35, 0.2); box-shadow: var(--shadow-neon);">
                        <i class="bi bi-person-bounding-box fs-2"></i>
                    </div>
                    <h3 class="fw-extrabold mb-1 typewriter-text mx-auto" style="color: var(--cafe-primary); display: inline-block;">HỆ THỐNG QUẢN TRỊ</h3>
                    <p class="text-muted small mt-2">Dành cho nhân viên và quản lý hệ thống</p>
                </div>

                <form id="account" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3 fw-bold" role="alert"></div>
                    
                    <div class="form-floating mb-3">
                        <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                        <label asp-for="Input.Email" class="form-label">Tài khoản Email</label>
                        <span asp-validation-for="Input.Email" class="text-danger small fw-bold"></span>
                    </div>
                    
                    <div class="form-floating mb-4">
                        <input asp-for="Input.Password" class="form-control" autocomplete="current-password" aria-required="true" placeholder="password" />
                        <label asp-for="Input.Password" class="form-label">Mật khẩu bảo mật</label>
                        <span asp-validation-for="Input.Password" class="text-danger small fw-bold"></span>
                    </div>
                    
                    <div class="checkbox mb-4 d-flex justify-content-between align-items-center">
                        <label asp-for="Input.RememberMe" class="form-label mb-0 fs-6 cursor-pointer">
                            <input class="form-check-input me-1" asp-for="Input.RememberMe" />
                            Ghi nhớ đăng nhập
                        </label>
                        <a id="forgot-password" asp-page="./ForgotPassword" class="small text-decoration-none fw-bold text-cafe-primary-hover transition-base" style="color: var(--cafe-accent);">Quên mật khẩu?</a>
                    </div>
                    
                    <div>
                        <button id="login-submit" type="submit" class="w-100 btn btn-cafe btn-lg magnetic-btn text-uppercase tracking-wider fw-extrabold">ĐĂNG NHẬP <i class="bi bi-box-arrow-in-right ms-2 fs-5"></i></button>
                    </div>
                    
                    <div class="text-center mt-4">
                        <p class="mb-0 text-muted small">
                            Chưa có tài khoản? 
                            <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl" class="fw-bold text-decoration-none" style="color: var(--cafe-primary);">Liên hệ Admin cấp quyền</a>
                        </p>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(document).ready(function() {
            // Magnetic Button
            const magneticBtns = document.querySelectorAll('.magnetic-btn');
            magneticBtns.forEach(btn => {
                btn.addEventListener('mousemove', e => {
                    const rect = btn.getBoundingClientRect();
                    const h = rect.width / 2;
                    const x = e.clientX - rect.left - h;
                    const y = e.clientY - rect.top - rect.height / 2;
                    btn.style.transform = `translate(${x * 0.2}px, ${y * 0.2}px)`;
                });
                
                btn.addEventListener('mouseleave', () => {
                    btn.style.transform = `translate(0px, 0px)`;
                });
            });
        });
    </script>
}

@section Styles {
    <style>
        /* Hide layout sidebar & navbar for login page for a cleaner look */
        .navbar-sidebar, .customer-top-bar, .customer-bottom-nav {
            display: none !important;
        }
        
        .main-container {
            margin-left: 0 !important;
            max-width: 100% !important;
            padding: 0 !important;
            display: flex;
            align-items: center;
            min-height: 100vh;
        }
        
        main[role="main"] {
            width: 100%;
        }

        
        .transition-base {
            transition: all 0.3s ease;
        }
        .text-cafe-primary-hover:hover {
            color: var(--cafe-primary) !important;
            text-shadow: 0 0 10px rgba(245, 166, 35, 0.4);
        }
    </style>
}
